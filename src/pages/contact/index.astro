---
import MainLayout from "@layouts/MainLayout.astro";
import Link from "@components/shared/Link.astro";
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import { createLocalizedConstants } from "@lib/constants";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const constants = createLocalizedConstants(lang);

const pageTitle = t('page.contact.title');
const pageDescription = t('page.contact.description');
---

<MainLayout title={pageTitle} description={pageDescription} direction={constants.LANGUAGE_DIRECTION}>
  <main
    class="flex min-h-screen w-full items-center justify-center bg-blue-50 py-12 transition-all duration-300 ease-in-out dark:bg-gradient-to-br dark:from-[#0f172a] dark:via-[#1e293b] dark:to-[#0a192f]"
  >
    <div class="section-container w-full">
      <!-- Introduction Section -->
      <div class="light:bg-white/80 mx-auto mb-8 w-full max-w-3xl rounded-2xl border border-blue-100 p-8 shadow-2xl backdrop-blur-md transition-colors duration-300 dark:border-sky-900 dark:bg-gradient-to-br dark:from-slate-900/80 dark:via-slate-800/80 dark:to-slate-900/60 dark:shadow-2xl dark:backdrop-blur-md">
        <h1 class="mb-6 text-center text-3xl font-bold text-blue-700 dark:text-sky-200">
          {t('contact.title')}
        </h1>
        <div class="prose prose-blue dark:prose-invert mx-auto max-w-none text-center">
          <p class="text-lg leading-relaxed text-blue-700 dark:text-sky-100">
            I'm always excited to connect with fellow developers, potential collaborators, and anyone interested in technology. Whether you have a project in mind, want to discuss web development, or just want to say hello, I'd love to hear from you.
          </p>
          <p class="mt-4 text-base text-blue-600 dark:text-sky-200">
            {t('contact.availability')} | {t('contact.responseTime')}
          </p>
        </div>
      </div>

      <!-- Contact Form -->
      <form
        method="POST"
        class="light:border-blue-100 light:bg-white/80 mx-auto w-full max-w-3xl rounded-2xl border border-blue-100 bg-white/80 p-8 shadow-2xl backdrop-blur-md transition-all duration-300 ease-in-out dark:border-sky-900 dark:bg-black/40 dark:shadow-2xl dark:backdrop-blur-md"
        id="contact-form"
      >
        <h1
          class="mb-6 text-center text-2xl font-bold text-blue-700 dark:text-sky-200"
        >
          Send Me a Message
        </h1>
        <div id="form-messages" class="mb-4"></div>
        <div class="mb-4">
          <label
            for="name"
            class="mb-2 block font-medium text-blue-700 dark:text-sky-100"
          >
            {t('contact.name')}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full rounded-md border border-blue-100 bg-blue-50 px-4 py-2 text-base text-blue-900 focus:border-blue-400 focus:outline-none dark:border-sky-800 dark:bg-slate-900/60 dark:text-sky-100 dark:focus:border-sky-400"
          />
        </div>
        <div class="mb-4">
          <label
            for="email"
            class="mb-2 block font-medium text-blue-700 dark:text-sky-100"
          >
            {t('contact.email')}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            dir="ltr"
            class="w-full rounded-md border border-blue-100 bg-blue-50 px-4 py-2 text-base text-blue-900 focus:border-blue-400 focus:outline-none dark:border-sky-800 dark:bg-slate-900/60 dark:text-sky-100 dark:focus:border-sky-400"
          />
        </div>
        <div class="mb-4">
          <label
            for="subject"
            class="mb-2 block font-medium text-blue-700 dark:text-sky-100"
          >
            {t('contact.subject')}
          </label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            class="w-full rounded-md border border-blue-100 bg-blue-50 px-4 py-2 text-base text-blue-900 focus:border-blue-400 focus:outline-none dark:border-sky-800 dark:bg-slate-900/60 dark:text-sky-100 dark:focus:border-sky-400"
          />
        </div>
        <div class="mb-6">
          <label
            for="message"
            class="mb-2 block font-medium text-blue-700 dark:text-sky-100"
          >
            {t('contact.message')}
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="w-full resize-none rounded-md border border-blue-100 bg-blue-50 px-4 py-2 text-base text-blue-900 focus:border-blue-400 focus:outline-none dark:border-sky-800 dark:bg-slate-900/60 dark:text-sky-100 dark:focus:border-sky-400"
          ></textarea>
        </div>
        <input type="hidden" name="theme" id="theme-input" value="dark" />
        <button
          type="submit"
          class="mb-6 w-full rounded bg-blue-700 px-6 py-2 text-base font-semibold text-white shadow transition hover:bg-blue-600 dark:bg-sky-700 dark:hover:bg-sky-600"
        >
          {t('contact.send')}
        </button>
      </form>

      <div
        class="light:bg-white/80 mx-auto mt-8 w-full max-w-3xl rounded-2xl border border-blue-100 p-8 shadow-2xl backdrop-blur-md transition-colors duration-300 dark:border-sky-900 dark:bg-gradient-to-br dark:from-slate-900/80 dark:via-slate-800/80 dark:to-slate-900/60 dark:shadow-2xl dark:backdrop-blur-md"
      >
        <h2
          class="mb-6 text-center text-2xl font-extrabold text-blue-700 drop-shadow-lg dark:text-sky-200"
        >
          {t('contact.otherWays')}
        </h2>
        <ul
          class="mb-4 flex flex-col items-center gap-6 md:flex-row md:justify-center"
        >
          <li>
            <Link
              href="/github"
              icon={{ name: "mdi:github", position: "left" }}
              text="GitHub"
              class="flex items-center gap-2 rounded-lg bg-blue-100 px-4 py-3 text-blue-700 shadow transition hover:bg-blue-200 hover:text-blue-900 dark:bg-slate-900/60 dark:text-sky-100 dark:hover:bg-sky-800/80 dark:hover:text-sky-400"
            />
          </li>
          <li>
            <Link
              href="/linkedin"
              icon={{ name: "mdi:linkedin", position: "left" }}
              text="LinkedIn"
              class="flex items-center gap-2 rounded-lg bg-blue-100 px-4 py-3 text-blue-700 shadow transition hover:bg-blue-200 hover:text-blue-900 dark:bg-slate-900/60 dark:text-sky-100 dark:hover:bg-sky-800/80 dark:hover:text-sky-400"
            />
          </li>
          <li>
            <Link
              href="mailto:saif@saifabdelrazek.com"
              icon={{ name: "mdi:email-outline", position: "left" }}
              text="Email"
              class="flex items-center gap-2 rounded-lg bg-blue-100 px-4 py-3 text-blue-700 shadow transition hover:bg-blue-200 hover:text-blue-900 dark:bg-slate-900/60 dark:text-sky-100 dark:hover:bg-sky-800/80 dark:hover:text-sky-400"
            />
          </li>
        </ul>
        <p class="mt-2 text-center text-base text-blue-700 dark:text-sky-200">
          {t('contact.dontHesitate')}
        </p>
      </div>

      <!-- Additional Information Section -->
      <div class="light:bg-white/80 mx-auto mt-8 w-full max-w-3xl rounded-2xl border border-blue-100 p-8 shadow-2xl backdrop-blur-md transition-colors duration-300 dark:border-sky-900 dark:bg-gradient-to-br dark:from-slate-900/80 dark:via-slate-800/80 dark:to-slate-900/60 dark:shadow-2xl dark:backdrop-blur-md">
        <h2 class="mb-6 text-center text-2xl font-extrabold text-blue-700 drop-shadow-lg dark:text-sky-200">
          What I Can Help With
        </h2>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="rounded-lg bg-blue-50 p-6 dark:bg-slate-900/40">
            <h3 class="mb-3 text-lg font-semibold text-blue-700 dark:text-sky-300">Web Development</h3>
            <p class="text-blue-600 dark:text-sky-100">
              Full-stack web applications, responsive websites, APIs, and modern JavaScript frameworks like React, Next.js, and Astro.
            </p>
          </div>
          <div class="rounded-lg bg-blue-50 p-6 dark:bg-slate-900/40">
            <h3 class="mb-3 text-lg font-semibold text-blue-700 dark:text-sky-300">Freelance Projects</h3>
            <p class="text-blue-600 dark:text-sky-100">
              Custom websites, e-commerce solutions, portfolio sites, and business applications tailored to your specific needs.
            </p>
          </div>
          <div class="rounded-lg bg-blue-50 p-6 dark:bg-slate-900/40">
            <h3 class="mb-3 text-lg font-semibold text-blue-700 dark:text-sky-300">Collaboration</h3>
            <p class="text-blue-600 dark:text-sky-100">
              Open source contributions, team projects, code reviews, and mentoring opportunities in web development.
            </p>
          </div>
          <div class="rounded-lg bg-blue-50 p-6 dark:bg-slate-900/40">
            <h3 class="mb-3 text-lg font-semibold text-blue-700 dark:text-sky-300">Tech Discussions</h3>
            <p class="text-blue-600 dark:text-sky-100">
              Sharing knowledge about programming, discussing new technologies, career advice, and learning opportunities.
            </p>
          </div>
        </div>
        <div class="mt-8 text-center">
          <p class="text-blue-700 dark:text-sky-100">
            Based in <strong>Gharbiya, Egypt</strong> • Available for remote work worldwide
          </p>
          <p class="mt-2 text-sm text-blue-600 dark:text-sky-200">
            Fluent in English and Arabic • Open to projects of all sizes
          </p>
        </div>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ t: {
    sending: t('contact.sending'),
    success: t('contact.success'),
    error: t('contact.error'),
    tryAgain: t('contact.tryAgain')
  } }}>
  const handleContactFormFunctionality = function() {
      const form = document.getElementById('contact-form');
      const formMessages = document.getElementById('form-messages');
      const submitButton = form.querySelector('button[type="submit"]');
      const originalButtonText = submitButton.textContent;

      // Form fields for localStorage
      const fields = ['name', 'email', 'subject', 'message'];
      const storageKey = 'contact-form-data';

      // Save form data to localStorage
      function saveFormData() {
        const formData = {};
        fields.forEach(field => {
          const element = document.getElementById(field);
          if (element && element.value.trim()) {
            formData[field] = element.value;
          }
        });
        
        if (Object.keys(formData).length > 0) {
          localStorage.setItem(storageKey, JSON.stringify(formData));
        }
      }

      // Restore form data from localStorage
      function restoreFormData() {
        try {
          const savedData = localStorage.getItem(storageKey);
          if (savedData) {
            const formData = JSON.parse(savedData);
            fields.forEach(field => {
              const element = document.getElementById(field);
              if (element && formData[field]) {
                element.value = formData[field];
              }
            });
          }
        } catch (error) {
          console.warn('Error restoring form data:', error);
          localStorage.removeItem(storageKey);
        }
      }

      // Clear saved form data
      function clearFormData() {
        localStorage.removeItem(storageKey);
      }

      // Get user's theme
      function getUserData() {
        // Get current theme
        const theme = document.documentElement.getAttribute('data-theme') || 
                     (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.getElementById('theme-input').value = theme;
      }

      // Initialize
      getUserData();
      restoreFormData();

      // Save form data on input changes
      const saveFieldsData = () => {
      fields.forEach(field => {
        const element = document.getElementById(field);
        if (element) {
          element.addEventListener('input', saveFormData);
          element.addEventListener('blur', saveFormData);
        }
      });
    };
      saveFieldsData();

      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Clear previous messages
        formMessages.innerHTML = '';
        
        // Disable submit button and show loading state
        submitButton.disabled = true;
        submitButton.textContent = t.sending;
        
        // Get form data
        const formData = new FormData(form);
        const data = {
          name: formData.get('name'),
          email: formData.get('email'),
          subject: formData.get('subject'),
          message: formData.get('message'),
          theme: formData.get('theme')
        };

        try {
          const response = await fetch('/api/contact.json', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (response.ok && result.success) {
            formMessages.innerHTML = `
              <div class="rounded-md bg-green-50 p-4 border border-green-200 dark:bg-green-900/20 dark:border-green-800">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">${t.success}</p>
                  </div>
                </div>
              </div>
            `;
            form.reset();
            clearFormData(); // Clear saved data after successful submission
            getUserData(); // Refresh theme field
          } else {
            throw new Error(result.error || t.error);
          }
        } catch (error) {
          formMessages.innerHTML = `
            <div class="rounded-md bg-red-50 p-4 border border-red-200 dark:bg-red-900/20 dark:border-red-800">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-red-800 dark:text-red-200">${error.message} ${t.tryAgain}</p>
                </div>
              </div>
            </div>
          `;
        } finally {
          // Re-enable submit button
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText;
        }
      });
    }
    handleContactFormFunctionality();
  document.addEventListener('astro:after-swap', handleContactFormFunctionality);
  </script>
</MainLayout>