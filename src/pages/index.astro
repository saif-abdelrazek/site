---
import MainLayout from "../layouts/MainLayout.astro";
import Home from "../sections/portfolio/Home.astro";
import About from "../sections/portfolio/About.astro";
import Technologies from "../sections/portfolio/Technologies.astro";
import Projects from "../sections/portfolio/Projects.astro";
import Education from "../sections/portfolio/Education.astro";
import Footer from "../sections/portfolio/Footer.astro";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = t('page.home.title');
const pageDescription = t('page.home.description');
---

<MainLayout title={pageTitle} description={pageDescription} direction={lang === 'ar' ? 'rtl' : 'ltr'}>
  <main
    class="flex min-h-screen w-full flex-col items-center justify-center bg-blue-50 transition-colors duration-300 dark:bg-gradient-to-br dark:from-[#0f172a] dark:via-[#1e293b] dark:to-[#0a192f]"
  >
    {Home && <Home lang={lang} />}
    {
      !Home && (
        <div class="mx-auto max-w-5xl px-4 py-12">
          <p class="text-lg text-gray-700 dark:text-gray-300">{ lang === 'ar' ?
            'قسم الصفحة الرئيسية غير متوفر حاليًا. يرجى التحقق مرة أخرى لاحقًا.' :
            `Home section is currently unavailable. Please check back later.`}
          </p>
        </div>
      )
    }
    {About && <About lang={lang} />}
    {
      !About && (
        <div class="mx-auto max-w-5xl px-4 py-12">
          <p class="text-lg text-gray-700 dark:text-gray-300">{ lang === 'ar' ?
            'قسم حول غير متوفر حاليًا. يرجى التحقق مرة أخرى لاحقًا.' :
            'About section is currently unavailable. Please check back later.'
          }</p>
        </div>
      )
    }
    {Technologies && <Technologies lang={lang} />}
    {
      !Technologies && (
        <div class="mx-auto max-w-5xl px-4 py-12">
          <p class="text-lg text-gray-700 dark:text-gray-300">{ lang === 'ar' ?
            'قسم التقنيات غير متوفر حاليًا. يرجى التحقق مرة أخرى لاحقًا.' :
            'Technologies section is currently unavailable. Please check back later.'
          }</p>
        </div>
      )
    }
    {Projects && <Projects lang={lang} />}
    {
      !Projects && (
        <div class="mx-auto max-w-5xl px-4 py-12">
          <p class="text-lg text-gray-700 dark:text-gray-300">{ lang === 'ar' ?
            'قسم المشاريع غير متوفر حاليًا. يرجى التحقق مرة أخرى لاحقًا.' :
            'Projects section is currently unavailable. Please check back later.'
          }</p>
        </div>
      )
    }
    {Education && <Education lang={lang} />}
    {
      !Education && (
        <div class="mx-auto max-w-5xl px-4 py-12">
          <p class="text-lg text-gray-700 dark:text-gray-300">{ lang === 'ar' ?
            'قسم التعليم غير متوفر حاليًا. يرجى التحقق مرة أخرى لاحقًا.' :
            'Education section is currently unavailable. Please check back later.'
          }</p>
        </div>
      )
    }
    {Footer && <Footer lang={lang} />}
    {
      !Footer && (
        <div class="mx-auto max-w-5xl px-4 py-12">
          <p class="text-lg text-gray-700 dark:text-gray-300">{ lang === 'ar' ?
            'قسم التذييل غير متوفر حاليًا. يرجى التحقق مرة أخرى لاحقًا.' :
            'Footer section is currently unavailable. Please check back later.'
          }</p>
        </div>
      )
    }
  </main>
</MainLayout>
