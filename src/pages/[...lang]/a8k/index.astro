---
import MainLayout from "@layouts/MainLayout.astro";
import Card from "@components/ui/Card.astro";
import { getLangFromUrl, getI18nStaticPaths } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import { createLocalizedConstants } from "@lib/constants";
import Button from "@components/ui/Button.astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = getI18nStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const constants = createLocalizedConstants(lang);

const pageTitle = t('page.a8k.title');
const pageDescription = t('page.a8k.description');

// Language prefix for links
const langPrefix = lang === 'en' ? '' : `/${lang}`;
---

<MainLayout title={pageTitle} description={pageDescription} direction={constants.LANGUAGE_DIRECTION}>
  <!-- Enhanced JSON-LD for A8K Brand Page -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "A8K: My Developer Signature",
      "description": "A8K is a numeronym-style developer signature derived from the surname Abdelrazek. A comprehensive reference for understanding the format, usage, and implementation of this professional identifier.",
      "url": "https://saifabdelrazek.com/a8k",
      "about": {
        "@type": "Brand",
        "name": "A8K",
        "alternateName": ["Abdelrazek", "A-8-K"],
        "description": "A numeronym-style developer signature derived from the surname Abdelrazek, following the pattern of i18n and l10n. A represents the first letter, 8 represents eight removed letters (bdelraze), and K represents the last letter.",
        "url": "https://a8k.dev",
        "founder": {
          "@type": "Person",
          "name": "Saif Abdelrazek",
          "url": "https://saifabdelrazek.com"
        },
        "sameAs": [
          "https://saifabdelrazek.com/a8k",
          "https://a8k.dev"
        ]
      },
      "mainEntity": {
        "@type": "Brand",
        "name": "A8K"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://saifabdelrazek.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "A8K",
            "item": "https://saifabdelrazek.com/a8k"
          }
        ]
      }
    }
  </script>

  <!-- Hero Section -->
  <div class="relative bg-gradient-to-br from-blue-600 via-indigo-700 to-blue-800 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900">
    <!-- Decorative elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 h-80 w-80 rounded-full bg-indigo-500/20 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 h-80 w-80 rounded-full bg-blue-500/20 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 mb-4">
          <Icon name="mdi:signature-text" class="h-8 w-8 text-blue-200" />
          <span class="text-blue-200 font-medium">
            {t('page.a8k.header.subtitle')}
          </span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          {t('page.a8k.header.title')}
        </h1>
        <p class="text-xl text-blue-100 leading-relaxed mb-8">
          {t('page.a8k.header.description')}
        </p>

        <!-- Quick nav to sections -->
        <div class="flex flex-wrap gap-2">
          <Button variant="filter" href="#what-is-a8k">
            <Icon name="mdi:help-circle-outline" class="h-4 w-4" />
            {t('page.a8k.navigation.whatIs')}
          </Button>
          <Button variant="filter" href="#how-used">
            <Icon name="mdi:application-cog-outline" class="h-4 w-4" />
            {t('page.a8k.navigation.howUsed')}
          </Button>
          <Button variant="filter" href="#why-a8k">
            <Icon name="mdi:lightbulb-outline" class="h-4 w-4" />
            {t('page.a8k.navigation.why')}
          </Button>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Sections -->
  <main class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- What is A8K Section -->
    <section id="what-is-a8k" class="mb-12">
      <Card variant="elevated">
        <div class="p-6">
          <h2 class="mb-4 text-3xl font-bold text-blue-700 dark:text-sky-300">
            {t('a8k.whatIs.title')}
          </h2>
          <div class="space-y-3 text-lg text-gray-700 dark:text-gray-300">
            <p>{t('a8k.whatIs.intro')}</p>

            <div dir="ltr" class="my-4 rounded-lg bg-blue-50 p-6 dark:bg-slate-800/60">
              <div class="flex flex-wrap items-center justify-center gap-3 text-2xl font-bold text-blue-700 dark:text-sky-200">
                <span >
                  <span class="breakdown-letter text-4xl text-blue-600 dark:text-sky-300">A</span>bdelraze<span class="breakdown-letter text-4xl text-blue-600 dark:text-sky-300">k</span>
                </span>
                <span class="text-2xl">→</span>
                <span class="inline-flex items-center gap-1">
                  <span class="breakdown-letter text-4xl text-blue-600 dark:text-sky-300">A</span>
                  <span class="text-xl">{t('a8k.whatIs.plus')}</span>
                  <span class="text-3xl text-blue-600 dark:text-sky-300">8</span>
                  <span class="text-base whitespace-nowrap">{t('a8k.whatIs.letters')}</span>
                  <span class="text-xl">{t('a8k.whatIs.plus')}</span>
                  <span class="breakdown-letter text-4xl text-blue-600 dark:text-sky-300">K</span>
                </span>
                <span class="text-2xl">→</span>
                <span class="breakdown-final text-5xl font-extrabold text-blue-600 dark:text-sky-300">A8K</span>
              </div>
            </div>

            <p>{t('a8k.whatIs.explanation')}</p>
          </div>
        </div>
      </Card>
    </section>

    <!-- How It's Used Section -->
    <section id="how-used" class="mb-12">
      <Card variant="elevated">
        <div class="p-6">
          <h2 class="mb-4 text-3xl font-bold text-blue-700 dark:text-sky-300">
            {t('a8k.howUsed.title')}
          </h2>
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div>
                <h3 class="mb-1 text-xl font-semibold text-blue-700 dark:text-sky-300">
                  {t('a8k.howUsed.signature.title')}
                </h3>
                <p class="text-gray-700 dark:text-gray-300">
                  {t('a8k.howUsed.signature.description')}
                </p>
                <p class="mt-2 rounded-lg bg-blue-50 p-3 font-mono text-blue-700 dark:bg-slate-800/60 dark:text-sky-200">
                  Saif Abdelrazek (A8K)
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div>
                <h3 class="mb-1 text-xl font-semibold text-blue-700 dark:text-sky-300">
                  {t('a8k.howUsed.domain.title')}
                </h3>
                <p class="text-gray-700 dark:text-gray-300">
                  {t('a8k.howUsed.domain.description')}
                </p>
                <a
                  href="https://a8k.dev"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-block rounded-lg bg-blue-50 p-3 font-mono text-blue-700 hover:bg-blue-100 dark:bg-slate-800/60 dark:text-sky-200 dark:hover:bg-slate-700"
                >
                  a8k.dev
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div>
                <h3 class="mb-1 text-xl font-semibold text-blue-700 dark:text-sky-300">
                  {t('a8k.howUsed.username.title')}
                </h3>
                <p class="text-gray-700 dark:text-gray-300">
                  {t('a8k.howUsed.username.description')}
                </p>
                <div class="mt-2 flex gap-2">
                  <span class="rounded-lg bg-blue-50 px-3 py-2 font-mono text-sm text-blue-700 dark:bg-slate-800/60 dark:text-sky-200">
                    saifabdelrazek
                  </span>
                  <span class="rounded-lg bg-blue-50 px-3 py-2 font-mono text-sm text-blue-700 dark:bg-slate-800/60 dark:text-sky-200">
                    saif-abdelrazek
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Card>
    </section>

    <!-- Why A8K Section -->
    <section id="why-a8k" class="mb-12">
      <Card variant="elevated">
        <div class="p-6">
          <h2 class="mb-4 text-3xl font-bold text-blue-700 dark:text-sky-300">
            {t('a8k.why.title')}
          </h2>
          <div class="grid gap-4 md:grid-cols-2">
            <div class="rounded-lg border border-blue-100 p-4 dark:border-sky-900">
              <h3 class="mb-2 text-xl font-semibold text-blue-700 dark:text-sky-300">
                {t('a8k.why.memorable.title')}
              </h3>
              <p class="text-gray-700 dark:text-gray-300">
                {t('a8k.why.memorable.description')}
              </p>
            </div>

            <div class="rounded-lg border border-blue-100 p-4 dark:border-sky-900">
              <h3 class="mb-2 text-xl font-semibold text-blue-700 dark:text-sky-300">
                {t('a8k.why.professional.title')}
              </h3>
              <p class="text-gray-700 dark:text-gray-300">
                {t('a8k.why.professional.description')}
              </p>
            </div>

            <div class="rounded-lg border border-blue-100 p-4 dark:border-sky-900">
              <h3 class="mb-2 text-xl font-semibold text-blue-700 dark:text-sky-300">
                {t('a8k.why.consistent.title')}
              </h3>
              <p class="text-gray-700 dark:text-gray-300">
                {t('a8k.why.consistent.description')}
              </p>
            </div>

            <div class="rounded-lg border border-blue-100 p-4 dark:border-sky-900">
              <h3 class="mb-2 text-xl font-semibold text-blue-700 dark:text-sky-300">
                {t('a8k.why.inspired.title')}
              </h3>
              <p class="text-gray-700 dark:text-gray-300">
                {t('a8k.why.inspired.description')}
              </p>
            </div>
          </div>
        </div>
      </Card>
    </section>

    <!-- Call to Action Section -->
    <section class="mb-8">
      <Card variant="elevated">
        <div class="p-6 text-center">
          <h2 class="mb-3 text-3xl font-bold text-blue-700 dark:text-sky-300">
            {t('a8k.cta.title')}
          </h2>
          <p class="mb-4 text-lg text-gray-700 dark:text-gray-300">
            {t('a8k.cta.description')}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <Button
              variant="cta-primary"
              href={`${langPrefix}/projects`}
            >
              {t('a8k.cta.button')}
            </Button>
            <Button
              variant="cta-secondary"
              href={`${langPrefix}/blog/story-behind-a8k`}
            >
              {t('a8k.cta.blogLink')}
            </Button>
          </div>
        </div>
      </Card>
    </section>
    </div>
  </main>

  <!-- Back to Top Button -->
  <a
    id="backToTop"
    href="#"
    class="pointer-events-none fixed right-6 bottom-6 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-blue-600 text-white opacity-0 shadow-lg transition-all duration-300 hover:bg-blue-700 dark:bg-indigo-600 dark:hover:bg-indigo-700"
    aria-label="Back to top"
  >
    <Icon name="mdi:arrow-up" class="h-5 w-5" />
  </a>

  <script>
    const initBackToTop = () => {
      const btn = document.getElementById("backToTop");
      if (!btn) return;

      window.addEventListener("scroll", () => {
        if (window.scrollY > 400) {
          btn.classList.remove("opacity-0", "pointer-events-none");
          btn.classList.add("opacity-100", "pointer-events-auto");
        } else {
          btn.classList.add("opacity-0", "pointer-events-none");
          btn.classList.remove("opacity-100", "pointer-events-auto");
        }
      });

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    };

    document.addEventListener("DOMContentLoaded", initBackToTop);
    document.addEventListener("astro:after-swap", initBackToTop);
  </script>


<style>
  .breakdown-letter {
    transition: all 0.3s ease;
    display: inline-block;
  }

  .breakdown-letter:hover {
    transform: scale(1.1);
    color: #2563eb;
  }

  .breakdown-final {
    transition: all 0.4s ease;
    display: inline-block;
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .font-arabic {
    font-family: 'Cairo', 'Tajawal', sans-serif;
  }

  @keyframes pulse-glow {
    0%, 100% {
      transform: scale(1);
      text-shadow: 0 0 10px rgba(37, 99, 235, 0.3);
    }
    50% {
      transform: scale(1.05);
      text-shadow: 0 0 20px rgba(37, 99, 235, 0.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .breakdown-letter,
    .breakdown-final {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  window.addEventListener("scroll", () => {
    const btn = document.getElementById("backToTop");
    if (!btn) return;
    if (window.scrollY > 200) {
      btn.classList.remove("opacity-0", "pointer-events-none");
      btn.classList.add("opacity-100", "pointer-events-auto");
    } else {
      btn.classList.add("opacity-0", "pointer-events-none");
      btn.classList.remove("opacity-100", "pointer-events-auto");
    }
  });
</script>


<style>
  .breakdown-letter {
    transition: all 0.3s ease;
    display: inline-block;
  }
  
  .breakdown-letter:hover {
    transform: scale(1.1);
    color: #2563eb;
  }
  
  .breakdown-final {
    transition: all 0.4s ease;
    display: inline-block;
    animation: pulse-glow 2s ease-in-out infinite;
  }
  
  .font-arabic {
    font-family: 'Cairo', 'Tajawal', sans-serif;
  }
  
  @keyframes pulse-glow {
    0%, 100% {
      transform: scale(1);
      text-shadow: 0 0 10px rgba(37, 99, 235, 0.3);
    }
    50% {
      transform: scale(1.05);
      text-shadow: 0 0 20px rgba(37, 99, 235, 0.5);
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    .breakdown-letter,
    .breakdown-final {
      animation: none;
      transition: none;
    }
  }
</style>
