---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getLangFromUrl, languages, defaultLang, showDefaultLang } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import Button from "@components/ui/Button.astro";
import { createLocalizedConstants } from "@lib/constants";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const constants = createLocalizedConstants(lang);

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection("projects");
  const paths = [];
  
  for (const lang of Object.keys(languages)) {
    const langProjects = projects.filter(project => project.id.startsWith(`${lang}/`));
    
    for (const project of langProjects) {
      const slug = project.id.replace(`${lang}/`, '');
      paths.push({
        params: { 
          lang: lang === defaultLang && !showDefaultLang ? undefined : lang,
          slug 
        },
        props: { project },
      });
    }
  }
  
  return paths;
};

interface Props {
  project: CollectionEntry<"projects">;
}

const { slug } = Astro.params;
const { project } = Astro.props as Props;

if (!project) {
  throw new Error("Project not found");
}

const { title, description, image, technologies, link, repo } = project.data;
const { Content } = await render(project);

const pageTitle = `${title} - ${t('projects.title')}`;
---

<MainLayout title={pageTitle} description={description} direction={constants.LANGUAGE_DIRECTION}>
  <main
    class="flex min-h-screen flex-col items-center justify-center bg-blue-50 py-12 dark:bg-slate-900"
    >
    <div class="mb-6 flex w-full max-w-3xl justify-start">
      <Button
        variant="back"
        href={lang === 'en' ? '/#projects' : `/${lang}/#projects`}
        aria-label={t('ui.backToTop')}
      >
        <Icon name={constants.LANGUAGE_DIRECTION === "rtl" ? "mdi:arrow-right" : "mdi:arrow-left"} class="h-5 w-5" />
        {t('projects.backToSection')}
      </Button>
    </div>
  <div
  class="w-full max-w-3xl rounded-2xl bg-white p-8 shadow-xl dark:bg-slate-800"
  transition:name={"project-card-" + slug}
  >
  {
        image && (
          <Image
            src={image}
            alt={title}
            class="mb-6 h-56 w-full rounded-xl object-cover"
            loading="lazy"
            />
          )
        }
      <h1 class="mb-4 text-3xl font-bold text-sky-700 dark:text-sky-300">
        {title}
      </h1>
      {
        description && (
          <p class="mb-6 text-lg text-gray-700 dark:text-gray-200">
            {description}
          </p>
        )
      }
      {
        technologies && technologies.length > 0 && (
          <div class="mb-6 flex flex-wrap gap-3">
            {technologies.map((tech) => (
              <a
              href={`/technologies/#${tech.slug}`}
              class="inline-flex items-center gap-1 rounded bg-blue-100 px-2 py-1 text-xs font-semibold text-blue-700 dark:bg-sky-900/60 dark:text-sky-200"
              >
                {tech.icon && <Icon name={tech.icon} class="h-5 w-5" />}
                {tech.name}
              </a>
            ))}
          </div>
        )
      }
      <div class="flex gap-4">
        {
          link && (
            <a
            href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-blue-600 underline hover:text-blue-800 dark:text-sky-400 dark:hover:text-sky-200"
              >
              {t('projects.live')}
            </a>
          )
        }
        {
          repo && (
            <a
              href={repo}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-blue-600 underline hover:text-blue-800 dark:text-sky-400 dark:hover:text-sky-200"
            >
              {t('ui.sourceCode')}
            </a>
          )
        }
      </div>
      <article class="prose prose-sky dark:prose-invert mt-8">
        <Content />
      </article>
    </div>
  </main>
</MainLayout>
