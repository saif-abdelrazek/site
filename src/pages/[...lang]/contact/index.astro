---
import MainLayout from "@layouts/MainLayout.astro";
import Link from "@components/shared/Link.astro";
import ContactForm from "@components/shared/ContactForm.astro";
import { getLangFromUrl, getI18nStaticPaths } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import { createLocalizedConstants, SOCIAL_LINKS } from "@lib/constants";

export const getStaticPaths = getI18nStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const constants = createLocalizedConstants(lang);

const pageTitle = t('page.contact.title');
const pageDescription = t('page.contact.description');
---

<MainLayout title={pageTitle} description={pageDescription} direction={constants.LANGUAGE_DIRECTION}>
  <!-- ContactPage Schema -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Saif Abdelrazek",
    "description": pageDescription,
    "url": new URL(Astro.url.pathname, Astro.site).toString(),
    "inLanguage": lang === "ar" ? "ar" : "en",
    "mainEntity": {
      "@type": "Person",
      "name": "Saif Abdelrazek",
      "alternateName": "A8K",
      "jobTitle": "Full-stack Developer",
      "url": "https://saifabdelrazek.com",
      "email": "saif@saifabdelrazek.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Gharbiya",
        "addressCountry": "EG"
      },
      "sameAs": [
        SOCIAL_LINKS.github,
        SOCIAL_LINKS.linkedin
      ],
      "knowsLanguage": ["en", "ar"]
    }
  })} />

  <main class="bg-blue-50 py-8 transition-all duration-300 ease-in-out dark:bg-gradient-to-br dark:from-[#0f172a] dark:via-[#1e293b] dark:to-[#0a192f]">
    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Header Section -->
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-blue-700 dark:text-sky-200 mb-4">
          {t('contact.title')}
        </h1>
        <p class="text-lg text-blue-600 dark:text-sky-100 max-w-2xl mx-auto">
          {t('contact.description')}
        </p>
        <p class="mt-3 text-sm text-blue-600 dark:text-sky-200">
          {t('contact.availability')} | {t('contact.responseTime')}
        </p>
      </div>

      <!-- Main Content Grid -->
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <ContactForm />
        </div>

        <!-- Sidebar with Contact Info and Services -->
        <div class="space-y-6">
          <!-- Quick Contact Links -->
          <div class="bg-white/90 dark:bg-slate-900/90 rounded-xl border border-blue-100 dark:border-sky-900 p-6 shadow-lg backdrop-blur-md">
            <h3 class="text-lg font-semibold text-blue-700 dark:text-sky-200 mb-4">
              {t('contact.otherWays')}
            </h3>
            <div class="space-y-3">
              <Link
                href={SOCIAL_LINKS.github}
                icon={{ name: "mdi:github", position: "left" }}
                text="GitHub"
                class="flex items-center gap-3 p-3 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors dark:bg-slate-900/60 dark:text-sky-100 dark:hover:bg-sky-800/80"
              />
              <Link
                href={SOCIAL_LINKS.linkedin}
                icon={{ name: "mdi:linkedin", position: "left" }}
                text="LinkedIn"
                class="flex items-center gap-3 p-3 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors dark:bg-slate-900/60 dark:text-sky-100 dark:hover:bg-sky-800/80"
              />
              <Link
                href={SOCIAL_LINKS.email}
                icon={{ name: "mdi:email-outline", position: "left" }}
                text={t('contact.email')}
                class="flex items-center gap-3 p-3 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors dark:bg-slate-900/60 dark:text-sky-100 dark:hover:bg-sky-800/80"
              />
            </div>
          </div>

          <!-- Location & Availability -->
          <div class="bg-white/90 dark:bg-slate-900/90 rounded-xl border border-blue-100 dark:border-sky-900 p-6 shadow-lg backdrop-blur-md">
            <h3 class="text-lg font-semibold text-blue-700 dark:text-sky-200 mb-4">
              {t('contact.locationAvailability')}
            </h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-center gap-2 text-blue-600 dark:text-sky-100">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                </svg>
                <span>{constants.SITE_CONFIG.location}</span>
              </div>
              <div class="flex items-center gap-2 text-blue-600 dark:text-sky-100">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                </svg>
                <span>{t('contact.remoteWork')}</span>
              </div>
              <div class="flex items-center gap-2 text-blue-600 dark:text-sky-100">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <span>{t('contact.languages')}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Services Section -->
      <div class="mt-8">
        <div class="bg-white/90 dark:bg-slate-900/90 rounded-xl border border-blue-100 dark:border-sky-900 p-6 shadow-lg backdrop-blur-md">
          <h2 class="text-2xl font-semibold text-blue-700 dark:text-sky-200 mb-6 text-center">
            {t('contact.helpWith')}
          </h2>
          <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="bg-blue-50 dark:bg-slate-900/40 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-blue-600 dark:text-sky-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 4a1 1 0 011-1h12a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1V8zm2 2a1 1 0 000 2h.01a1 1 0 100-2H5zm3 0a1 1 0 000 2h3a1 1 0 100-2H8z" clip-rule="evenodd" />
                </svg>
                <h3 class="font-semibold text-blue-700 dark:text-sky-300">{t('contact.webDev.title')}</h3>
              </div>
              <p class="text-sm text-blue-600 dark:text-sky-100">
                {t('contact.webDev.description')}
              </p>
            </div>
            <div class="bg-blue-50 dark:bg-slate-900/40 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-blue-600 dark:text-sky-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd" />
                  <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z" />
                </svg>
                <h3 class="font-semibold text-blue-700 dark:text-sky-300">{t('contact.freelance.title')}</h3>
              </div>
              <p class="text-sm text-blue-600 dark:text-sky-100">
                {t('contact.freelance.description')}
              </p>
            </div>
            <div class="bg-blue-50 dark:bg-slate-900/40 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-blue-600 dark:text-sky-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z" />
                  <path d="M6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" />
                </svg>
                <h3 class="font-semibold text-blue-700 dark:text-sky-300">{t('contact.collaboration.title')}</h3>
              </div>
              <p class="text-sm text-blue-600 dark:text-sky-100">
                {t('contact.collaboration.description')}
              </p>
            </div>
            <div class="bg-blue-50 dark:bg-slate-900/40 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-blue-600 dark:text-sky-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 13V5a2 2 0 00-2-2H4a2 2 0 00-2 2v8a2 2 0 002 2h3l3 3 3-3h3a2 2 0 002-2zM5 7a1 1 0 011-1h8a1 1 0 110 2H6a1 1 0 01-1-1zm1 3a1 1 0 100 2h3a1 1 0 100-2H6z" clip-rule="evenodd" />
                </svg>
                <h3 class="font-semibold text-blue-700 dark:text-sky-300">{t('contact.techDiscussions.title')}</h3>
              </div>
              <p class="text-sm text-blue-600 dark:text-sky-100">
                {t('contact.techDiscussions.description')}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</MainLayout>