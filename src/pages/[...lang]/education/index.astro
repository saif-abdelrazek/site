---
/**
 * Education Landing Page
 *
 * A narrative-driven education page divided into thematic sections:
 * 1. Formal Academic Foundation
 * 2. Autodidact & Developer Journey
 * 3. Integrative Projects & Capstones
 * 4. Vision & Forward Path
 */
import { getCollection } from "astro:content";
import CareerLayout from "@layouts/CareerLayout.astro";
import EducationSection from "@components/education/EducationSection.astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, getI18nStaticPaths } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import Button from "@components/ui/Button.astro";
import { SECTION_CONFIG } from "@types/educationTypes";

export const getStaticPaths = getI18nStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Fetch all institutions and moments for current language
const allInstitutions = await getCollection("institutions");
const allMoments = await getCollection("moments");

// Filter for current language
const institutions = allInstitutions.filter((i) => i.id.startsWith(`${lang}/`));
const moments = allMoments.filter((m) => m.id.startsWith(`${lang}/`));

// Sort by order
institutions.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
moments.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Section configurations with narratives
const sections = [
  {
    id: "formal" as const,
    title: t('education.formal.title'),
    narrative: t('education.formal.narrative'),
    featuredMoments: ["thanaweya-amma-focus"],
    showCarousel: true,
  },
  {
    id: "self-learning" as const,
    title: t('education.selfLearning.title'),
    narrative: t('education.selfLearning.narrative'),
    featuredMoments: ["starting-html-css", "mastering-javascript", "opensource-portfolio"],
    showCarousel: true,
  },
];

const pageTitle = t('page.education.title');
const pageDescription = t('page.education.description');

// Hero configuration
const heroConfig = {
  gradientFrom: "teal-500",
  gradientVia: "sky-500",
  gradientTo: "blue-700",
  decorativeTop: {
    position: "-top-40 -right-40",
    color: "bg-blue-500/20"
  },
  decorativeBottom: {
    position: "-bottom-40 -left-40",
    color: "bg-indigo-500/20"
  },
  icon: "mdi:school-outline",
  subtitle: t('page.education.header.subtitle'),
  title: t('page.education.header.title'),
  description: t('page.education.header.description'),
  stats: [
    { value: institutions.length, label: t('ui.institutions') },
    { value: moments.length, label: t('ui.moments') },
    { value: sections.length, label: t('ui.sections') }
  ],
  navigation: [
    { href: "#formal", icon: "mdi:school", label: t('nav.formalEducation') },
    { href: "#self-learning", icon: "mdi:book-open-page-variant", label: t('nav.selfLearning') }
  ]
};
---

<CareerLayout title={pageTitle} description={pageDescription} hero={heroConfig} gradientClass="bg-gradient-to-br from-teal-500 via-sky-500 to-blue-700">
  {sections.map((section) => (
    <EducationSection
      sectionId={section.id}
      title={section.title}
      narrative={section.narrative}
      institutions={institutions}
      moments={moments}
      featuredMoments={section.featuredMoments}
      showCarousel={section.showCarousel}
    />
  ))}
</CareerLayout>
