---
/**
 * Moment Detail Page
 *
 * Shows a specific learning moment/milestone
 * Route: /education/[institution]/[moment]
 */
import { getCollection, render } from "astro:content";
import MomentLayout from "@layouts/MomentLayout.astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import { SECTION_CONFIG } from "@types/educationTypes";
import type { EducationSection } from "@types/educationTypes";

export async function getStaticPaths() {
  const institutions = await getCollection("institutions");
  const moments = await getCollection("moments");

  const paths = [];

  for (const moment of moments) {
    const lang = moment.id.split("/")[0];
    const institutionSlug = moment.data.institutionSlug;
    const momentSlug = moment.data.slug;

    // Find the corresponding institution
    const institution = institutions.find(
      (i) => i.id.startsWith(`${lang}/`) && i.data.slug === institutionSlug
    );

    if (institution) {
      // Get other moments from same institution for navigation
      const siblingMoments = moments.filter(
        (m) => m.id.startsWith(`${lang}/`) && m.data.institutionSlug === institutionSlug
      ).sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

      const currentIndex = siblingMoments.findIndex(m => m.data.slug === momentSlug);

      paths.push({
        params: {
          lang: lang === "en" ? undefined : lang,
          institution: institutionSlug,
          moment: momentSlug,
        },
        props: {
          moment,
          institution,
          prevMoment: currentIndex > 0 ? siblingMoments[currentIndex - 1] : null,
          nextMoment: currentIndex < siblingMoments.length - 1 ? siblingMoments[currentIndex + 1] : null,
        },
      });
    }
  }

  return paths;
}

const { moment, institution, prevMoment, nextMoment } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Render moment content
const { Content } = await render(moment);

// Get section config
const sectionConfig = SECTION_CONFIG[moment.data.section as EducationSection];

// Build breadcrumb
const breadcrumb = [
  {
    label: t('nav.home'),
    href: lang === "en" ? "/#education" : `/${lang}/#education`
  },
  {
    label: t('nav.education'),
    href: lang === "en" ? "/education" : `/${lang}/education`
  },
  {
    label: institution.data.shortName || institution.data.name,
    href: `${lang === "en" ? "" : `/${lang}`}/education/${institution.data.slug}`
  },
  {
    label: moment.data.title,
    href: "#"
  }
];

// Navigation items
const prevItem = prevMoment ? {
  title: prevMoment.data.title,
  href: `${lang === "en" ? "" : `/${lang}`}/education/${institution.data.slug}/${prevMoment.data.slug}`
} : undefined;

const nextItem = nextMoment ? {
  title: nextMoment.data.title,
  href: `${lang === "en" ? "" : `/${lang}`}/education/${institution.data.slug}/${nextMoment.data.slug}`
} : undefined;

// Back to section
const backToSection = {
  label: `${t('education.backToInstitution')} ${institution.data.name}`,
  href: `${lang === "en" ? "" : `/${lang}`}/education/${institution.data.slug}`
};

// Create proper page title like blog posts
const pageTitle = (moment.data.title || 'Untitled Moment') + " | " + t('page.education.title');
---

<MomentLayout
  title={pageTitle}
  headerTitle={moment.data.title}
  description={moment.data.excerpt}
  image={moment.data.image}
  date={new Date(moment.data.date)}
  lang={lang}
  breadcrumb={breadcrumb}
  backToSection={backToSection}
  prevItem={prevItem}
  nextItem={nextItem}
>
  <!-- Header Slot -->
  <fragment slot="header">
    <!-- Section Badge -->
    <span
      class:list={[
        "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold mb-4",
        sectionConfig.bgColor,
        sectionConfig.color,
      ]}
    >
      <Icon name={sectionConfig.icon} class="h-3.5 w-3.5" />
      {moment.data.section === 'formal' ? t('education.formal.title') : t('education.selfLearning.title')}
    </span>
  </fragment>

  <!-- Meta Slot -->
  <fragment slot="meta">
    <a
      href={`${lang === "en" ? "" : `/${lang}`}/education/${institution.data.slug}`}
      class="flex items-center gap-2 hover:text-white transition-colors"
    >
      {institution.data.logo && (
        <img
          src={institution.data.logo.src}
          alt={institution.data.name}
          class="h-6 w-6 rounded-md object-cover"
        />
      )}
      <span>{institution.data.name}</span>
    </a>
  </fragment>

  <!-- Header Footer Slot -->
  <fragment slot="header-footer">
    <!-- Tags -->
    {moment.data.tags && moment.data.tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {moment.data.tags.map((tag: string) => (
          <span class="rounded-full bg-white/10 px-3 py-1 text-sm font-medium text-white">
            {tag}
          </span>
        ))}
      </div>
    )}
  </fragment>

  <!-- Article Slot -->
  <fragment slot="article">
    <Content />
  </fragment>
</MomentLayout>
