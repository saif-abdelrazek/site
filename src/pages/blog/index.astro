---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import SearchBtn from "@components/blog/search/SearchBtn.astro";
import SeriesCarousel from "@components/blog/SeriesCarousel.astro";
import CategoryTags from "@components/blog/CategoryTags.astro";
import BlogPostCard from "@components/blog/BlogPostCard.astro";
import { createLocalizedConstants } from "@lib/constants";
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import type { CollectionEntry } from "astro:content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const constants = createLocalizedConstants(lang);
const { PAGE_TITLES, PAGE_DESCRIPTIONS, BLOG_CONFIG } = constants;

// Get all posts for the current language
const allPosts = await getCollection("posts");
const posts = allPosts
  .filter((post: CollectionEntry<'posts'>) => post.id.startsWith(`${lang}/`))
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Separate pinned and regular posts
const pinnedPosts = posts.filter((post: CollectionEntry<'posts'>) => post.data.pinned === true)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => {
    // Sort by pinnedOrder first (ascending), then by date (descending)
    if (a.data.pinnedOrder !== undefined && b.data.pinnedOrder !== undefined) {
      return a.data.pinnedOrder - b.data.pinnedOrder;
    }
    if (a.data.pinnedOrder !== undefined) return -1;
    if (b.data.pinnedOrder !== undefined) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });
const regularPosts = posts.filter((post: CollectionEntry<'posts'>) => post.data.pinned !== true);

// Combine with pinned posts first
const allPostsSorted = [...pinnedPosts, ...regularPosts];

// Extract unique categories with counts
const categoryMap = new Map<string, number>();
posts.forEach((post: CollectionEntry<'posts'>) => {
  if (post.data.category) {
    categoryMap.set(post.data.category, (categoryMap.get(post.data.category) || 0) + 1);
  }
});

const categories = Array.from(categoryMap.entries()).map(([name, count]) => ({
  name,
  slug: name.toLowerCase().replace(/\s+/g, '-'),
  count
}));

const title = BLOG_CONFIG?.title;
const description = t('page.blogPage.description');
const blogUrl = new URL('/blog', Astro.site).toString();
---

<MainLayout
  title={PAGE_TITLES.blog}
  description={PAGE_DESCRIPTIONS.blog}
  linksInHead={[
    `<link
      rel="alternate"
      type="application/rss+xml"
      title="${t('blog.feedTitle')}"
      href="${new URL("/blog/rss.xml", Astro.site)}"
    />`,
  ]}
>
  <!-- Blog Schema -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": title,
    "description": description,
    "url": blogUrl,
    "inLanguage": lang,
    "author": {
      "@type": "Person",
      "name": "Saif Abdelrazek",
      "url": "https://saifabdelrazek.com",
      "alternateName": "A8K"
    }
  })} />

  <div class="min-h-screen w-full bg-blue-50 dark:bg-gradient-to-br dark:from-[#0f172a] dark:via-[#1e293b] dark:to-[#0a192f] transition-all duration-300">
    <main class="section-container py-12">
      <div class="mx-auto max-w-7xl">
        <!-- Header - Inline with Search -->
        <header class="mb-8 min-h-[120px]">
          <div class="flex items-start gap-4 justify-between">
            <div class="flex-1">
              <h1 class="text-4xl font-black text-gray-900 dark:text-white mb-2">
                {title}
              </h1>
              {description && (
                <p class="text-base text-gray-600 dark:text-gray-400">
                  {description}
                </p>
              )}
            </div>
            <!-- <div class="flex-shrink-0">
              <SearchBtn />
            </div> -->
          </div>
        </header>

        <!-- Two Column Layout: Posts (Left) + Series Sidebar (Right) -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
          <!-- Main Content: Posts (3/4 width on large screens) -->
          <div class="lg:col-span-3">
            <!-- All Posts with Load More (Pinned appear first) -->
            <section>
              <div class="flex items-center justify-between mb-6 gap-4 flex-wrap">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                  {lang === 'ar' ? 'جميع المقالات' : 'All Posts'}
                </h2>
                <div class="flex flex-wrap gap-2">
                  <a
                    href={`/${lang === 'ar' ? 'ar/' : ''}blog`}
                    class="px-3 py-1.5 text-sm rounded-lg font-medium bg-blue-600 text-white shadow-sm hover:bg-blue-700 transition-colors"
                  >
                    {lang === 'ar' ? 'الكل' : 'All'}
                  </a>
                  {categories.map((category) => (
                    <a
                      href={`/${lang === 'ar' ? 'ar/' : ''}blog/category/${category.slug}`}
                      class="px-3 py-1.5 text-sm rounded-lg font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                    >
                      {(() => {
                        const key = `category.${category.slug}` as any;
                        return t(key) || category.slug;
                      })()}
                      <span class="ml-1.5 text-xs opacity-75">({category.count})</span>
                    </a>
                  ))}
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
                {allPostsSorted.map((post, index) => (
                  <div class={index >= 6 ? 'hidden load-more-post' : ''} data-index={index}>
                    <BlogPostCard post={post} />
                  </div>
                ))}
              </div>
              {allPostsSorted.length > 6 && (
                <div class="mt-8 text-center">
                  <button
                    id="load-more-btn"
                    class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors duration-200 shadow-md hover:shadow-lg"
                  >
                    {lang === 'ar' ? 'تحميل المزيد' : 'Load More'}
                  </button>
                </div>
              )}
            </section>
            <script>
                const handleLoadMore = () => {
              const loadMoreBtn = document.getElementById('load-more-btn');
              if (loadMoreBtn) {
                const postsPerPage = 6;
                const totalPosts = document.querySelectorAll('[data-index]').length;
                let currentlyShown = 6;

                loadMoreBtn.addEventListener('click', () => {
                  const allHiddenPosts = document.querySelectorAll('.load-more-post');
                  const postsToShow = Array.from(allHiddenPosts).slice(0, postsPerPage);
                  postsToShow.forEach(post => {
                    post.classList.remove('hidden', 'load-more-post');
                  });
                  currentlyShown += postsToShow.length;
                  
                  if (currentlyShown >= totalPosts) {
                    loadMoreBtn.style.display = 'none';
                  }
                });
              }}
                document.addEventListener('DOMContentLoaded', handleLoadMore);
                document.addEventListener('astro:after-swap', handleLoadMore);
            </script>
          </div>

          <!-- Sidebar: Series (1/4 width on large screens) -->
          <aside class="lg:col-span-1">
            <SeriesCarousel lang={lang} />
          </aside>
        </div>
      </div>
    </main>
  </div>
</MainLayout>
