---
import type { GetStaticPaths, Page } from "astro";
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import PostList from "@components/blog/PostList.astro";
import type { CollectionEntry } from "astro:content";
import SearchBtn from "@components/blog/search/SearchBtn.astro";
import { createLocalizedConstants } from "@lib/constants";
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const constants = createLocalizedConstants(lang);
const { PAGE_TITLES, PAGE_DESCRIPTIONS, BLOG_CONFIG } = constants;

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("posts");

  // Filter with lang - hardcode 'en' for English blog pages
  const englishPosts = posts.filter(post => post.id.startsWith(`en/`));

  const sortedPosts = englishPosts.sort((a, b) => {
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

  return paginate(sortedPosts, {
    pageSize: 6,
  });
};
interface Props {
  page: Page<CollectionEntry<"posts">>;
}
const { page } = Astro.props;
const posts = page?.data;

const pageTitle = PAGE_TITLES.blog;
const pageDescription = PAGE_DESCRIPTIONS.blog;

const title = BLOG_CONFIG?.title;
const description = t('page.blogPage.description');

// Schema.org data for blog listing
const blogUrl = new URL('/blog', Astro.site).toString();
const itemListElements = posts.map((post, index) => ({
  "@type": "ListItem",
  "position": index + 1,
  "url": new URL(`/blog/${post.id.replace('en/', '')}`, Astro.site).toString(),
  "name": post.data.title
}));
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  linksInHead={[
    `<link
      rel="alternate"
      type="application/rss+xml"
      title="${t('blog.feedTitle')}"
      href={${new URL("/blog/rss.xml", Astro.site)}}
    />`,
  ]}
>
  <!-- Blog Schema for Blog List Page -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": title,
    "description": description,
    "url": blogUrl,
    "inLanguage": "en",
    "author": {
      "@type": "Person",
      "name": "Saif Abdelrazek",
      "url": "https://saifabdelrazek.com",
      "alternateName": "A8K"
    },
    "blogPost": itemListElements.map(item => ({
      "@type": "BlogPosting",
      "url": item.url,
      "headline": item.name
    }))
  })} />
  <div
    class="light:bg-blue-50 min-h-screen w-full transition-all duration-300 ease-in-out dark:bg-gradient-to-br dark:from-[#0f172a] dark:via-[#1e293b] dark:to-[#0a192f]"
  >
    <main class="section-container py-12">
      <!-- Header Section -->
      <header
        class="light:bg-white/80 mx-auto mb-8 max-w-4xl rounded-2xl border border-blue-100 p-8 shadow-2xl backdrop-blur-md transition-all duration-300 ease-in-out dark:border-sky-900 dark:bg-gradient-to-br dark:from-slate-900/80 dark:via-slate-800/80 dark:to-slate-900/60 dark:shadow-2xl dark:backdrop-blur-md"
      >
        <h1
          class="mb-2 text-3xl font-extrabold tracking-tight text-blue-700 drop-shadow dark:text-sky-200"
        >
          {title.toUpperCase()}
        </h1>
        {
          description && (
            <p class="mb-6 text-blue-700/90 dark:text-sky-100/90">
              {description}
            </p>
          )
        }
        <SearchBtn />
      </header>
      <section class="mx-auto max-w-7xl">
        <!-- Posts Block -->
        <PostList {posts} />
      </section>
      <nav class="mt-8 flex items-center justify-center gap-2">
        {
          page.url.first ? (
            <a
              href={page.url.first}
              class="rounded-md bg-blue-100 px-3 py-1 text-blue-700 transition hover:bg-blue-200 dark:bg-slate-800 dark:text-sky-200 dark:hover:bg-slate-700"
              aria-label={t('pagination.first')}
            >
              «
            </a>
          ) : null
        }
        {
          page.url.prev ? (
            <a
              href={page.url.prev}
              class="rounded-md bg-blue-100 px-3 py-1 text-blue-700 transition hover:bg-blue-200 dark:bg-slate-800 dark:text-sky-200 dark:hover:bg-slate-700"
              aria-label={t('pagination.previous')}
            >
              ‹
            </a>
          ) : null
        }
        {
          page.url.next ? (
            <a
              href={page.url.next}
              class="rounded-md bg-blue-100 px-3 py-1 text-blue-700 transition hover:bg-blue-200 dark:bg-slate-800 dark:text-sky-200 dark:hover:bg-slate-700"
              aria-label={t('pagination.next')}
            >
              ›
            </a>
          ) : null
        }
        {
          page.url.last ? (
            <a
              href={page.url.last}
              class="rounded-md bg-blue-100 px-3 py-1 text-blue-700 transition hover:bg-blue-200 dark:bg-slate-800 dark:text-sky-200 dark:hover:bg-slate-700"
              aria-label={t('pagination.last')}
            >
              »
            </a>
          ) : null
        }
      </nav>
    </main>
  </div>
</MainLayout>
