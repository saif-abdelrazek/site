---
import { getCollection } from "astro:content";
import slugify from "../../../../utils/slugify";
import type { GetStaticPaths } from "astro";

// Export getStaticPaths to generate a static page for each unique author
export const getStaticPaths: GetStaticPaths = async () => {
  const allPosts = await getCollection("posts");
  
  // Filter for English posts only
  const englishPosts = allPosts.filter(post => post.id.startsWith("en/"));
  
  const authors = Array.from(
    new Set(
      englishPosts
        .map((post) => post.data.author)
        .filter((author) => typeof author === "string" && author.trim() !== ""),
    ),
  );
  
  const validPaths = [];
  for (const author of authors) {
    const slug = slugify(typeof author === "string" ? author : "");
    // Only include valid slugs
    if (slug && slug.trim() !== "") {
      validPaths.push({
        params: { slug }
      });
    }
  }
  
  return validPaths;
};
const { slug } = Astro.params;

if (slug) {
  return Astro.rewrite(`/blog/author/${slug}/1`);
}
---
