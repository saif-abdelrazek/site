---
import MainLayout from "@layouts/MainLayout.astro";
import { createLocalizedConstants } from "@lib/constants";
import { useTranslations } from "@i18n/translations";
import Button from "@components/ui/Button.astro";

const lang = "en";
const constants = createLocalizedConstants(lang);
const t = useTranslations(lang);

const PAGE_TITLES = constants.PAGE_TITLES;
const pageDescription = "The page you're looking for doesn't exist. It may have been moved, deleted, or the URL might be incorrect. Return to the homepage to continue exploring Saif Abdelrazek's portfolio and blog.";
---

<MainLayout title={PAGE_TITLES.notFound} description={pageDescription}>
  <main
    class="flex min-h-screen w-full max-w-full flex-col items-center justify-center bg-white px-4 text-center text-gray-900 transition-colors duration-300 dark:bg-gray-900 dark:text-white"
  >
    <!-- Animated 404 -->
    <div class="mb-6 flex items-center justify-center">
      <span
        class="text-7xl font-extrabold tracking-tight text-sky-700 drop-shadow dark:text-white"
        >4</span
      >
      <span class="mx-2 animate-spin text-4xl" style="animation-duration: 3s"
        >🚀</span
      >
      <span
        class="text-7xl font-extrabold tracking-tight text-sky-700 drop-shadow dark:text-white"
        >4</span
      >
    </div>

    <!-- Fun message -->
    <p class="mb-4 text-2xl text-sky-700 dark:text-sky-200">
      {t('error.404.title')}
    </p>
    <p class="mb-6 max-w-md text-gray-600 dark:text-gray-300">
      {t('error.404.message')}
    </p>

    <!-- Button -->
    <Button
      variant="go-home"
      href="/"
      class="group relative"
      data-astro-history="replace"
    >
      <span class="relative z-10">{t('error.404.button')}</span>
      <span
        class="absolute -top-2 -right-2 opacity-0 transition group-hover:opacity-100"
        >✨</span
      >
    </Button>
  </main>
</MainLayout>
