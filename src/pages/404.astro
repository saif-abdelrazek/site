---
import MainLayout from "../layouts/MainLayout.astro";
import { createLocalizedConstants } from "../lib/constants";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const constants = createLocalizedConstants(lang);
const t = useTranslations(lang);

const PAGE_TITLES = constants.PAGE_TITLES;
---

<MainLayout title={PAGE_TITLES.notFound}>
  <main
    class="flex min-h-screen w-screen flex-col items-center justify-center bg-white px-4 text-center text-gray-900 transition-colors duration-300 dark:bg-gray-900 dark:text-white"
  >
    <!-- Animated 404 -->
    <div class="mb-6 flex items-center justify-center">
      <span
        class="text-7xl font-extrabold tracking-tight text-sky-700 drop-shadow dark:text-white"
        >4</span
      >
      <span class="mx-2 animate-spin text-4xl" style="animation-duration: 3s"
        >🚀</span
      >
      <span
        class="text-7xl font-extrabold tracking-tight text-sky-700 drop-shadow dark:text-white"
        >4</span
      >
    </div>

    <!-- Fun message -->
    <p class="mb-4 text-2xl text-sky-700 dark:text-sky-200">
      {t('error.404.title')}
    </p>
    <p class="mb-6 max-w-md text-gray-600 dark:text-gray-300">
      {t('error.404.message')}
    </p>

    <!-- Button -->
    <a
      href={lang === "en" ? "/" : `/${lang}/`}
      class="group relative inline-block rounded-lg bg-sky-600 px-6 py-3 font-semibold text-white shadow transition hover:bg-sky-700"
      data-astro-history="replace"
    >
      <span class="relative z-10">{t('error.404.button')}</span>
      <span
        class="absolute -top-2 -right-2 opacity-0 transition group-hover:opacity-100"
        >👽</span
      >
    </a>
  </main>
</MainLayout>
