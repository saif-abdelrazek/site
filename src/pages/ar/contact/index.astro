---
import MainLayout from "@layouts/MainLayout.astro";
import Link from "@components/shared/Link.astro";
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import { createLocalizedConstants, SOCIAL_LINKS } from "@lib/constants";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const constants = createLocalizedConstants(lang);

const pageTitle = t('page.contact.title');
const pageDescription = t('page.contact.description');
---

<MainLayout title={pageTitle} description={pageDescription} direction={constants.LANGUAGE_DIRECTION}>
  <!-- ContactPage Schema (Arabic) -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "تواصل مع سيف عبدالرازق",
    "description": pageDescription,
    "url": new URL(Astro.url.pathname, Astro.site).toString(),
    "inLanguage": "ar",
    "mainEntity": {
      "@type": "Person",
      "name": "Saif Abdelrazek",
      "alternateName": "A8K",
      "jobTitle": "Full-stack Developer",
      "url": "https://saifabdelrazek.com",
      "email": "saif@saifabdelrazek.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Gharbiya",
        "addressCountry": "EG"
      },
      "sameAs": [
        SOCIAL_LINKS.github,
        SOCIAL_LINKS.linkedin
      ],
      "knowsLanguage": ["en", "ar"]
    }
  })} />

  <main class="bg-blue-50 py-8 transition-all duration-300 ease-in-out dark:bg-gradient-to-br dark:from-[#0f172a] dark:via-[#1e293b] dark:to-[#0a192f]">
    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Header Section -->
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-blue-700 dark:text-sky-200 mb-4">
          {t('contact.title')}
        </h1>
        <p class="text-lg text-blue-600 dark:text-sky-100 max-w-2xl mx-auto">
          أسعد دائماً بالتواصل مع زملاء المطورين والمتعاونين المحتملين وأي شخص مهتم بالتقنية.
        </p>
        <p class="mt-3 text-sm text-blue-600 dark:text-sky-200">
          {t('contact.availability')} | {t('contact.responseTime')}
        </p>
      </div>

      <!-- Main Content Grid -->
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <form
            method="POST"
            class="bg-white/90 dark:bg-slate-900/90 rounded-xl border border-blue-100 dark:border-sky-900 p-6 shadow-lg backdrop-blur-md"
            id="contact-form"
          >
            <h2 class="text-2xl font-semibold text-blue-700 dark:text-sky-200 mb-6">
              أرسل لي رسالة
            </h2>
            <div id="form-messages" class="mb-4"></div>
            
            <div class="grid md:grid-cols-2 gap-4 mb-4">
              <div>
                <label for="name" class="block text-sm font-medium text-blue-700 dark:text-sky-100 mb-2">
                  {t('contact.name')}
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full rounded-lg border border-blue-100 bg-blue-50 px-4 py-3 text-blue-900 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-200 dark:border-sky-800 dark:bg-slate-900/60 dark:text-sky-100 dark:focus:border-sky-400 dark:focus:ring-sky-800"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-blue-700 dark:text-sky-100 mb-2">
                  {t('contact.email')}
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  dir="ltr"
                  class="w-full rounded-lg border border-blue-100 bg-blue-50 px-4 py-3 text-blue-900 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-200 dark:border-sky-800 dark:bg-slate-900/60 dark:text-sky-100 dark:focus:border-sky-400 dark:focus:ring-sky-800"
                />
              </div>
            </div>
            
            <div class="mb-4">
              <label for="subject" class="block text-sm font-medium text-blue-700 dark:text-sky-100 mb-2">
                {t('contact.subject')}
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                class="w-full rounded-lg border border-blue-100 bg-blue-50 px-4 py-3 text-blue-900 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-200 dark:border-sky-800 dark:bg-slate-900/60 dark:text-sky-100 dark:focus:border-sky-400 dark:focus:ring-sky-800"
              />
            </div>
            
            <div class="mb-6">
              <label for="message" class="block text-sm font-medium text-blue-700 dark:text-sky-100 mb-2">
                {t('contact.message')}
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full resize-none rounded-lg border border-blue-100 bg-blue-50 px-4 py-3 text-blue-900 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-200 dark:border-sky-800 dark:bg-slate-900/60 dark:text-sky-100 dark:focus:border-sky-400 dark:focus:ring-sky-800"
                placeholder="أخبرني عن مشروعك أو سؤالك..."
              ></textarea>
            </div>
            
            <input type="hidden" name="theme" id="theme-input" value="dark" />
            <button
              type="submit"
              class="w-full rounded-lg bg-blue-700 px-6 py-3 text-white font-semibold shadow-lg transition hover:bg-blue-600 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-blue-200 dark:bg-sky-700 dark:hover:bg-sky-600 dark:focus:ring-sky-800"
            >
              {t('contact.send')}
            </button>
          </form>
        </div>

        <!-- Sidebar with Contact Info and Services -->
        <div class="space-y-6">
          <!-- Quick Contact Links -->
          <div class="bg-white/90 dark:bg-slate-900/90 rounded-xl border border-blue-100 dark:border-sky-900 p-6 shadow-lg backdrop-blur-md">
            <h3 class="text-lg font-semibold text-blue-700 dark:text-sky-200 mb-4">
              {t('contact.otherWays')}
            </h3>
            <div class="space-y-3">
              <Link
                href={SOCIAL_LINKS.github}
                icon={{ name: "mdi:github", position: "left" }}
                text="GitHub"
                class="flex items-center gap-3 p-3 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors dark:bg-slate-900/60 dark:text-sky-100 dark:hover:bg-sky-800/80"
              />
              <Link
                href={SOCIAL_LINKS.linkedin}
                icon={{ name: "mdi:linkedin", position: "left" }}
                text="LinkedIn"
                class="flex items-center gap-3 p-3 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors dark:bg-slate-900/60 dark:text-sky-100 dark:hover:bg-sky-800/80"
              />
              <Link
                href={SOCIAL_LINKS.email}
                icon={{ name: "mdi:email-outline", position: "left" }}
                text="البريد الإلكتروني"
                class="flex items-center gap-3 p-3 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors dark:bg-slate-900/60 dark:text-sky-100 dark:hover:bg-sky-800/80"
              />
            </div>
          </div>

          <!-- Location & Availability -->
          <div class="bg-white/90 dark:bg-slate-900/90 rounded-xl border border-blue-100 dark:border-sky-900 p-6 shadow-lg backdrop-blur-md">
            <h3 class="text-lg font-semibold text-blue-700 dark:text-sky-200 mb-4">
              الموقع والتوفر
            </h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-center gap-2 text-blue-600 dark:text-sky-100">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                </svg>
                <span>الغربية، مصر</span>
              </div>
              <div class="flex items-center gap-2 text-blue-600 dark:text-sky-100">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                </svg>
                <span>متاح للعمل عن بُعد</span>
              </div>
              <div class="flex items-center gap-2 text-blue-600 dark:text-sky-100">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <span>العربية والإنجليزية</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Services Section -->
      <div class="mt-8">
        <div class="bg-white/90 dark:bg-slate-900/90 rounded-xl border border-blue-100 dark:border-sky-900 p-6 shadow-lg backdrop-blur-md">
          <h2 class="text-2xl font-semibold text-blue-700 dark:text-sky-200 mb-6 text-center">
            ما يمكنني مساعدتك فيه
          </h2>
          <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="bg-blue-50 dark:bg-slate-900/40 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-blue-600 dark:text-sky-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 4a1 1 0 011-1h12a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1V8zm2 2a1 1 0 000 2h.01a1 1 0 100-2H5zm3 0a1 1 0 000 2h3a1 1 0 100-2H8z" clip-rule="evenodd" />
                </svg>
                <h3 class="font-semibold text-blue-700 dark:text-sky-300">تطوير الويب</h3>
              </div>
              <p class="text-sm text-blue-600 dark:text-sky-100">
                تطبيقات متكاملة وواجهات برمجية وأطر حديثة مثل React و Next.js و Astro.
              </p>
            </div>
            <div class="bg-blue-50 dark:bg-slate-900/40 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-blue-600 dark:text-sky-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd" />
                  <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z" />
                </svg>
                <h3 class="font-semibold text-blue-700 dark:text-sky-300">المشاريع الحرّة</h3>
              </div>
              <p class="text-sm text-blue-600 dark:text-sky-100">
                مواقع مخصصة وحلول تجارة إلكترونية وتطبيقات أعمال.
              </p>
            </div>
            <div class="bg-blue-50 dark:bg-slate-900/40 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-blue-600 dark:text-sky-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z" />
                  <path d="M6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" />
                </svg>
                <h3 class="font-semibold text-blue-700 dark:text-sky-300">التعاون</h3>
              </div>
              <p class="text-sm text-blue-600 dark:text-sky-100">
                مساهمات مفتوحة المصدر ومشاريع جماعية ومراجعة أكواد.
              </p>
            </div>
            <div class="bg-blue-50 dark:bg-slate-900/40 rounded-lg p-4">
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-blue-600 dark:text-sky-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 13V5a2 2 0 00-2-2H4a2 2 0 00-2 2v8a2 2 0 002 2h3l3 3 3-3h3a2 2 0 002-2zM5 7a1 1 0 011-1h8a1 1 0 110 2H6a1 1 0 01-1-1zm1 3a1 1 0 100 2h3a1 1 0 100-2H6z" clip-rule="evenodd" />
                </svg>
                <h3 class="font-semibold text-blue-700 dark:text-sky-300">النقاشات التقنية</h3>
              </div>
              <p class="text-sm text-blue-600 dark:text-sky-100">
                تبادل المعرفة والنصح المهني وفرص التعلم.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ t: {
    sending: t('contact.sending'),
    success: t('contact.success'),
    error: t('contact.error'),
    tryAgain: t('contact.tryAgain')
  } }}>
  const handleContactFormFunctionality = function() {
      const form = document.getElementById('contact-form');
      const formMessages = document.getElementById('form-messages');
      const submitButton = form.querySelector('button[type="submit"]');
      const originalButtonText = submitButton.textContent;

      // Form fields for localStorage
      const fields = ['name', 'email', 'subject', 'message'];
      const storageKey = 'contact-form-data';

      // Save form data to localStorage
      function saveFormData() {
        const formData = {};
        let hasData = false;
        
        fields.forEach(field => {
          const element = document.getElementById(field);
          if (element) {
            const value = element.value.trim();
            if (value) {
              formData[field] = value;
              hasData = true;
            }
          }
        });
        
        if (hasData) {
          localStorage.setItem(storageKey, JSON.stringify(formData));
        } else {
          localStorage.removeItem(storageKey);
        }
      }

      // Restore form data from localStorage
      function restoreFormData() {
        try {
          const savedData = localStorage.getItem(storageKey);
          if (savedData) {
            const formData = JSON.parse(savedData);
            fields.forEach(field => {
              const element = document.getElementById(field);
              if (element && formData[field]) {
                element.value = formData[field];
              }
            });
          }
        } catch (error) {
          console.warn('Error restoring form data:', error);
          localStorage.removeItem(storageKey);
        }
      }

      // Clear saved form data
      function clearFormData() {
        localStorage.removeItem(storageKey);
      }

      // Get user's theme
      function getUserData() {
        // Get current theme
        const theme = document.documentElement.getAttribute('data-theme') || 
                     (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.getElementById('theme-input').value = theme;
      }

      // Initialize
      getUserData();
      restoreFormData();

      // Save form data on input changes
      const saveFieldsData = () => {
        fields.forEach(field => {
          const element = document.getElementById(field);
          if (element) {
            element.addEventListener('input', saveFormData);
            element.addEventListener('keyup', saveFormData);
            element.addEventListener('blur', saveFormData);
          }
        });
      };
      saveFieldsData();

      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Clear previous messages
        formMessages.innerHTML = '';
        
        // Disable submit button and show loading state
        submitButton.disabled = true;
        submitButton.textContent = t.sending;
        
        // Get form data
        const formData = new FormData(form);
        const data = {
          name: formData.get('name'),
          email: formData.get('email'),
          subject: formData.get('subject'),
          message: formData.get('message'),
          theme: formData.get('theme')
        };

        try {
          const response = await fetch('/api/contact.json', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (response.ok && result.success) {
            formMessages.innerHTML = `
              <div class="rounded-md bg-green-50 p-4 border border-green-200 dark:bg-green-900/20 dark:border-green-800">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">${t.success}</p>
                  </div>
                </div>
              </div>
            `;
            form.reset();
            clearFormData(); // Clear saved data after successful submission
            getUserData(); // Refresh theme field
          } else {
            throw new Error(result.error || t.error);
          }
        } catch (error) {
          formMessages.innerHTML = `
            <div class="rounded-md bg-red-50 p-4 border border-red-200 dark:bg-red-900/20 dark:border-red-800">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-red-800 dark:text-red-200">${error.message} ${t.tryAgain}</p>
                </div>
              </div>
            </div>
          `;
        } finally {
          // Re-enable submit button
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText;
        }
      });
    }
    handleContactFormFunctionality();
  document.addEventListener('astro:after-swap', handleContactFormFunctionality);
  </script>
</MainLayout>