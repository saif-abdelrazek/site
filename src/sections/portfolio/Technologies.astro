---
import TechCard from "@components/portfolio/TechCard.astro";
import { useTranslations } from "@i18n/translations";
import { getLangFromUrl } from "@i18n/utils";
import { createLocalizedConstants } from "@lib/constants";

const {
  lang = getLangFromUrl(Astro.url),
} = Astro.props;

const t = useTranslations(lang);
const constants = createLocalizedConstants(lang);

const { items: technologies, title, description } = constants.PORTFOLIO_CONTENT.technologies;

// Extract unique categories from technologies
const categories = [
  ...new Set(
    technologies
      ?.map((tech: any) => tech.category)
      .filter(Boolean)
  ),
];

// Helper to get favourite tech per category
function getFavouriteTech(cat: string) {
  return technologies?.find((tech: any) => tech.category === cat && tech.favorite);
}

// Get up to 9 favourite techs (one per category, max 9)
const favouriteTechs = categories
  .map((cat: any) => getFavouriteTech(cat))
  .filter(Boolean)
  .slice(0, 9);
---

<section
  id="technologies"
  class="section-container section-spacing flex w-full flex-col items-center"
>
  <h2
    class="mb-6 text-center text-4xl font-extrabold text-sky-700 dark:text-sky-300"
  >
    {title}
  </h2>
  <p class="mb-10 text-center text-lg text-gray-700 dark:text-gray-300">
    {description}<br />
  </p>
  {
    favouriteTechs.length === 0 ? (
      <p class="text-lg text-gray-700 dark:text-gray-300">
        {t('tech.noFavorites')}
      </p>
    ) : (
      <div class="grid w-full grid-cols-1 items-stretch gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {favouriteTechs.map((tech) => {
          return tech ? (
            <TechCard
              name={tech.name}
              icon={tech.icon}
              level={tech.level}
              slug={tech.slug}
              category={tech.category}
              description={tech.description}
            />
          ) : null;
        })}
      </div>
    )
  }
  <div class="mt-10 flex justify-center">
    <a
      href={lang === 'en' ? "/tech" : `/${lang}/tech`}
      class="inline-block rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 px-7 py-3 text-lg font-semibold text-white shadow-lg ring-2 ring-blue-400/20 transition hover:scale-105 hover:from-blue-700 hover:to-sky-600 hover:shadow-xl dark:from-sky-700 dark:to-blue-800 dark:hover:from-sky-800 dark:hover:to-blue-900"
    >
      {t('tech.moreTechnologies')}
    </a>
  </div>
</section>
