---

import { Image } from "astro:assets";
import { useTranslations } from "@i18n/translations";
import { getLangFromUrl } from "@i18n/utils";
import { createLocalizedConstants } from "@lib/constants";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const constants = createLocalizedConstants(lang);

import profileImage from "@assets/profile.jpg";
const { title, subtitle, description } = constants.PORTFOLIO_CONTENT.hero;

---

<section id="home" class="w-full bg-white dark:bg-slate-900 px-4 py-16">
  <div class="mx-auto max-w-4xl section-container">
    <div class="flex flex-col items-center gap-10 md:flex-row md:items-stretch">
      <div class="flex-shrink-0 flex items-stretch min-h-[300px] max-h-[500px]">
        {profileImage && (
          <div class="rounded-2xl border border-gray-200 bg-white p-0 shadow-md dark:bg-slate-800 dark:border-slate-700 flex items-stretch min-h-[300px] max-h-[500px]">
            <Image
              src={profileImage}
              alt={title}
              class="h-full w-auto rounded-xl object-cover border-4 border-blue-100 dark:border-sky-900 min-h-[300px] max-h-[500px]"
              style="aspect-ratio: 1/1;"
              loading="lazy"
            />
          </div>
        )}
      </div>
      <div class="flex-1 flex items-stretch min-h-[300px] max-h-[500px]">
        <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-md dark:bg-slate-800 dark:border-slate-700 w-full flex flex-col justify-center min-h-[300px] max-h-[500px]">
          <span class="mb-4 inline-block w-fit rounded-full bg-gradient-to-r from-blue-600 to-sky-400 px-4 py-1 text-sm font-semibold text-white shadow-md">{t('page.home.tagline') ?? 'Welcome to my portfolio'}</span>
          <h1 class="mb-3 text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
            {title}
          </h1>
          <h2 class="mb-4 text-2xl font-semibold text-blue-600 dark:text-sky-400">
            {subtitle}
          </h2>
          <p class="mb-10 max-w-xl text-lg leading-relaxed text-gray-700 dark:text-gray-300">
            {description}
          </p>
          <div class="flex flex-wrap justify-center md:justify-start gap-4">
            <a
              href="#projects"
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 px-7 py-3 text-lg font-semibold text-white shadow-lg ring-2 ring-blue-400/20 transition hover:scale-105 hover:from-blue-700 hover:to-sky-600 hover:shadow-xl dark:from-sky-700 dark:to-blue-800 dark:hover:from-sky-800 dark:hover:to-blue-900"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              {t('page.home.viewProjects')}
            </a>
            <a
              href={lang === 'en' ? "/contact" : `/${lang}/contact`}
              class="inline-flex items-center gap-2 rounded-xl border-2 border-blue-600 px-7 py-3 text-lg font-semibold text-blue-700 transition hover:bg-blue-50 dark:border-sky-700 dark:text-sky-300 dark:hover:bg-slate-800"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4.5M16 12l-4-4m0 0l-4 4m4-4v12"/></svg>
              {t('page.home.contactMe')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
