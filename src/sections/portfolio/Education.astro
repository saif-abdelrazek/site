---
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { SECTION_CONFIG } from "@types/educationTypes";
import type { EducationSection } from "@types/educationTypes";
import { formatDate } from "@lib/utils/formateDate";
import EducationCard from "@components/portfolio/EducationCard.astro";
import Button from "@components/ui/Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Get institutions for current language
const allInstitutions = await getCollection("institutions");
const institutions = allInstitutions
  .filter((i) => i.id.startsWith(`${lang}/`))
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Show current first, then recent ones (up to 3)
const currentInstitutions = institutions.filter((i) => i.data.current);
const pastInstitutions = institutions.filter((i) => !i.data.current);
const displayInstitutions = [...currentInstitutions, ...pastInstitutions].slice(0, 3);

const hasInstitutions = displayInstitutions.length > 0;
---

<section id="education" class="w-full bg-gradient-to-br from-blue-50 via-white to-sky-100 light:from-blue-50 light:via-white light:to-sky-100 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900 px-4 py-12">
  <div class="mx-auto max-w-6xl">
    <h2 class="mb-2 text-center text-4xl font-bold text-sky-700 light:text-sky-700 dark:text-sky-300">
      {t('nav.education')}
    </h2>
    <p class="mb-8 text-center text-lg text-gray-700 light:text-gray-700 dark:text-gray-300">
      {t('education.description')}
    </p>

    {hasInstitutions ? (
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {displayInstitutions.map((institution) => {
          const section = institution.data.section as EducationSection;
          const sectionConfig = SECTION_CONFIG[section];
          
          return (
            <EducationCard
              institution={institution}
              section={section}
              t={t}
              lang={lang}
            />
          );
        })}
      </div>
    ) : (
      <div class="text-center text-lg text-gray-500 dark:text-gray-400">
        {t('education.noRecords')}
      </div>
    )}

    <div class="mt-10 flex justify-center">
      <Button
        variant="portfolio"
        href={lang === "en" ? "/education" : `/${lang}/education`}
      >
        {t('education.moreEducation')}
      </Button>
    </div>
  </div>
</section>
