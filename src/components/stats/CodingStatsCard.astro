---
interface Props {
  label: string;
  value: string;
  subvalue?: string;
}

const { label, value, subvalue } = Astro.props;
---

<div
  class="group flex h-full w-full flex-col items-center justify-center rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-300 ease-out hover:border-blue-500 hover:shadow-sm dark:bg-slate-800 dark:border-slate-700 dark:hover:border-sky-500 md:w-auto"
>
  <span
    class="mb-2 text-base font-semibold tracking-wide text-gray-900 uppercase dark:text-white whitespace-nowrap"
  >
    {label}
  </span>
  <span class="text-2xl font-bold text-gray-900 dark:text-white whitespace-nowrap">
    {value}
  </span>
  {
    subvalue && (
      <span class="text-xl font-bold text-gray-900 dark:text-white whitespace-nowrap">
        {subvalue}
      </span>
    )
  }
</div>
