---
interface Props {
  label: string;
  value: string;
  subvalue?: string;
}

const { label, value, subvalue } = Astro.props;
---

<div
  class="light:bg-blue-50 flex w-full flex-col items-center justify-center rounded-2xl border border-blue-100 p-6 shadow-md backdrop-blur-md transition-all duration-200 ease-out hover:shadow-lg hover:border-blue-300 light:hover:bg-blue-50/80 md:w-auto dark:border-sky-800 dark:bg-gradient-to-br dark:from-slate-900/80 dark:via-slate-800/80 dark:to-slate-900/60 dark:shadow-md dark:backdrop-blur-md dark:hover:border-sky-700"
>
  <span
    class="mb-2 text-base font-semibold tracking-wide text-blue-700 uppercase dark:text-sky-300"
  >
    {label}
  </span>
  <span class="text-2xl font-bold text-blue-700 dark:text-sky-100/90">
    {value}
  </span>
  {
    subvalue && (
      <span class="text-xl font-bold text-blue-700 dark:text-sky-100/90">
        {subvalue}
      </span>
    )
  }
</div>
