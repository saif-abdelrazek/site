---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger' | 'portfolio' | 'secondary-portfolio' | 'submit' | 'load-more' | 'back' | 'cta-primary' | 'cta-secondary' | 'go-home' | 'filter';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
  loading?: boolean;
  fullWidth?: boolean;
}

const { 
  variant = 'primary', 
  size = 'md', 
  href, 
  disabled = false,
  type = 'button',
  class: className = '',
  target,
  rel,
  loading = false,
  fullWidth = false,
  ...props 
} = Astro.props as Props; 

const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  outline: 'btn-outline',
  ghost: 'btn-ghost',
  danger: 'bg-red-500 text-white hover:bg-red-600 shadow-sm hover:shadow-md',
  portfolio: 'inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 px-7 py-3 text-lg font-semibold text-white shadow-lg ring-2 ring-blue-400/20 transition-all duration-300 hover:ring-blue-500 hover:shadow-lg dark:from-sky-700 dark:to-blue-800 dark:hover:ring-sky-400',
  'secondary-portfolio': 'inline-flex items-center gap-2 rounded-xl border-2 border-blue-600 px-7 py-3 text-lg font-semibold text-blue-700 transition-all duration-300 hover:border-blue-700 hover:bg-blue-50 dark:border-sky-700 dark:text-sky-300 dark:hover:border-sky-600 dark:hover:bg-slate-800',
  submit: 'flex-1 rounded-lg bg-blue-700 px-6 py-3 text-white font-semibold shadow-lg ring-2 ring-transparent hover:ring-blue-300 transition-all duration-300 hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-200 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-sky-700 dark:hover:bg-sky-600 dark:focus:ring-sky-800',
  'load-more': 'px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors duration-200 shadow-md hover:shadow-lg',
  back: 'inline-flex items-center gap-2 rounded bg-blue-100 px-3 py-2 font-semibold text-blue-700 transition-colors hover:bg-blue-200 dark:bg-sky-900/60 dark:text-sky-200 dark:hover:bg-sky-800',
  'cta-primary': 'inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-lg font-semibold text-white transition hover:bg-blue-700 dark:bg-sky-600 dark:hover:bg-sky-700',
  'cta-secondary': 'inline-flex items-center gap-2 rounded-lg border-2 border-blue-600 px-6 py-3 text-lg font-semibold text-blue-600 transition hover:bg-blue-50 dark:border-sky-600 dark:text-sky-600 dark:hover:bg-sky-900/20',
  'go-home': 'inline-block rounded bg-sky-700 px-6 py-2 text-base font-semibold text-white shadow transition hover:bg-sky-600',
  filter: 'inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white text-sm font-medium transition-colors duration-200'
};

const sizeClasses = {
  sm: 'btn-sm',
  md: 'btn-md',
  lg: 'btn-lg'
};

const classes = [
  variantClasses[variant],
  sizeClasses[size],
  fullWidth && 'w-full',
  loading && 'opacity-50 cursor-not-allowed',
  className
].filter(Boolean).join(' ');

const Element = href ? 'a' : 'button';
const linkProps = href ? { href, target, rel } : {};
const buttonProps = !href ? { type, disabled: disabled || loading } : {};
---

<Element 
  class={classes}
  {...linkProps}
  {...buttonProps}
  {...props}
>
  {loading && (
    <svg class="animate-spin -ml-1 mr-3 h-4 w-4 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  )}
  <slot />
</Element>