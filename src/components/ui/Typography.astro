---
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p' | 'span' | 'div' | 'label';
  variant?: 'hero' | 'section' | 'subsection' | 'card' | 'small' | 'body-hero' | 'body-large' | 'body-text' | 'body-small' | 'caption';
  class?: string;
  color?: 'default' | 'muted' | 'subtle' | 'primary' | 'secondary' | 'danger' | 'success';
  align?: 'left' | 'center' | 'right' | 'justify';
  weight?: 'normal' | 'medium' | 'semibold' | 'bold';
}

const { 
  as: Element = 'p', 
  variant = 'body-text', 
  class: className = '',
  color = 'default',
  align,
  weight
} = Astro.props as Props;

const variantClasses = {
  hero: 'heading-hero',
  section: 'heading-section',
  subsection: 'heading-subsection',
  card: 'heading-card',
  small: 'heading-small',
  'body-hero': 'body-hero',
  'body-large': 'body-large',
  'body-text': 'body-text',
  'body-small': 'body-small',
  caption: 'text-xs text-gray-500'
};

const colorClasses = {
  default: '',
  muted: 'text-muted',
  subtle: 'text-gray-400',
  primary: 'text-primary-600',
  secondary: 'text-gray-600',
  danger: 'text-red-600',
  success: 'text-green-600'
};

const alignClasses = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
  justify: 'text-justify'
};

const weightClasses = {
  normal: 'font-normal',
  medium: 'font-medium',
  semibold: 'font-semibold',
  bold: 'font-bold'
};

const classes = [
  variantClasses[variant],
  color !== 'default' ? colorClasses[color] : '',
  align ? alignClasses[align] : '',
  weight ? weightClasses[weight] : '',
  className
].filter(Boolean).join(' ');
---

<Element class={classes}>
  <slot />
</Element>