---
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";

interface Props {
  name: string;
  icon?: string;
  level?: string;
  favorite?: boolean;
  description?: string;
  resources?: Array<{ label: string; url: string }>;
  details?: string;
  slug?: string;
  link?: string;
}
const { name, icon, level, favorite, description, resources, details, link, slug } =
  Astro.props;
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Translate level
const getTranslatedLevel = (level: string) => {
  switch (level.toLowerCase()) {
    case 'expert': return t('tech.level.expert');
    case 'advanced': return t('tech.level.advanced');
    case 'intermediate': return t('tech.level.intermediate');
    case 'beginner': return t('tech.level.beginner');
    case 'novice': return t('tech.level.novice');
    default: return level;
  }
};

// Use the same icon styling logic as TechCard
const iconClass = icon?.startsWith("simple-icons:")
  ? "h-10 w-10 text-gray-800 dark:text-white"
  : "h-10 w-10 text-blue-400 dark:text-sky-400";
---

<div
  class="rounded-2xl border border-blue-500 bg-white p-4 sm:p-6 shadow-md transition-all duration-250 ease-out hover:shadow-lg hover:border-blue-600 light:hover:bg-blue-50/30 dark:bg-slate-900 dark:hover:border-sky-700"
  transition:name={"tech-card-" + slug}
  >
  <!-- Header section with icon and title -->
  <div class="mb-4">
    <div class="flex items-center gap-3 sm:gap-4">
      {icon && <Icon name={icon} class={`${iconClass} flex-shrink-0`} />}
      <h2 class="text-xl sm:text-2xl font-bold text-sky-700 dark:text-sky-300 leading-tight">
        {name}
      </h2>
    </div>
    
    <!-- Badges - responsive layout -->
    <div class="mt-2 flex flex-wrap gap-2">
      {
        level && (
          <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-700 dark:bg-sky-900/60 dark:text-sky-200">
            {getTranslatedLevel(level)}
          </span>
        )
      }
      {
        favorite && (
          <span class="inline-flex items-center rounded-full bg-yellow-200 px-2.5 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-400/30 dark:text-yellow-200">
            {t('tech.favorite.badge')}
          </span>
        )
      }
    </div>
  </div>

  <!-- Description -->
  {description && (
    <p class="mb-4 text-sm sm:text-base text-gray-700 dark:text-gray-200 leading-relaxed">
      {description}
    </p>
  )}

  <!-- Action buttons and links -->
  <div class="space-y-3">
    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-blue-100 px-3 py-2 text-sm font-medium text-blue-700 transition-colors hover:bg-blue-200 dark:bg-sky-900/60 dark:text-sky-200 dark:hover:bg-sky-900"
        >
          <span>{t('tech.moreInfo')}</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )
    }

    {
      resources && resources.length > 0 && (
        <div class="rounded-lg bg-gray-50 p-4 dark:bg-slate-800/50">
          <h3 class="mb-2 text-sm font-semibold text-gray-900 dark:text-gray-100">
            Resources:
          </h3>
          <ul class="space-y-1">
            {resources.map((r) => (
              <li>
                <a 
                  href={r.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800 dark:text-sky-400 dark:hover:text-sky-300 transition-colors"
                >
                  <span>{r.label}</span>
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <!-- Detailed content -->
  {
    details && (
      <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
        <article class="prose prose-sm sm:prose prose-sky dark:prose-invert max-w-none">
          {details}
        </article>
      </div>
    )
  }
</div>
