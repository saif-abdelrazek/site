---
/**
 * Unified TechCard Component
 * 
 * A versatile card that displays technology information
 * with visual indicators for level and category.
 * 
 * Variants:
 * - compact: For carousels and grids (horizontal scroll friendly)
 * - detailed: For expanded views on tech detail pages
 */
import { Icon } from "astro-icon/components";
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";
import { TECH_CATEGORY_CONFIG, LEVEL_CONFIG, type Technology, type TechCategory, type TechLevel } from "@types/techTypes";

interface Props {
  tech: Technology;
  variant?: "compact" | "detailed";
  showCategory?: boolean;
  class?: string;
}

const {
  tech,
  variant = "compact",
  showCategory = true,
  class: className = "",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isRtl = lang === "ar";

// Get category configuration
const categoryConfig = TECH_CATEGORY_CONFIG[tech.category as TechCategory];
const levelConfig = tech.level ? LEVEL_CONFIG[tech.level as TechLevel] : null;

// Translate level
const getTranslatedLevel = (level: string) => {
  switch (level.toLowerCase()) {
    case 'expert': return t('tech.level.expert');
    case 'advanced': return t('tech.level.advanced');
    case 'intermediate': return t('tech.level.intermediate');
    case 'beginner': return t('tech.level.beginner');
    case 'novice': return t('tech.level.novice');
    default: return level;
  }
};

// Build the link URL
const linkUrl = lang === "en" ? `/technologies#${tech.slug}` : `/${lang}/technologies#${tech.slug}`;
---

<a
  href={linkUrl}
  id={tech.slug}
  class:list={[
    "group block h-full rounded-2xl border bg-white transition-all duration-300 ease-out",
    "hover:shadow-lg hover:border-blue-400 dark:hover:border-sky-600",
    "dark:bg-slate-800 dark:border-slate-700",
    "border-gray-200",
    variant === "compact" ? "p-5" : "p-6",
    className,
  ]}
  dir={isRtl ? "rtl" : "ltr"}
>
  <!-- Top Row: Category Badge + Favorite -->
  <div class="flex items-center justify-between mb-4">
    {showCategory && categoryConfig && (
      <span
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold",
          categoryConfig.bgColor,
          categoryConfig.color,
        ]}
      >
        <Icon name={categoryConfig.icon} class="h-3.5 w-3.5" />
        {isRtl ? categoryConfig.labelAr : categoryConfig.label}
      </span>
    )}
    {tech.favorite && (
      <span class="inline-flex items-center gap-1 rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300">
        <Icon name="mdi:star" class="h-3 w-3" />
        {isRtl ? "مفضل" : "Favorite"}
      </span>
    )}
  </div>

  <!-- Icon + Name Row -->
  <div class="flex items-start gap-3 mb-3">
    {tech.icon && (
      <div class="flex-shrink-0">
        <Icon
          name={tech.icon}
          class:list={[
            "h-10 w-10 rounded-lg",
            tech.icon.startsWith("simple-icons:") 
              ? "text-gray-800 dark:text-white" 
              : "text-blue-600 dark:text-sky-400"
          ]}
        />
      </div>
    )}
    <div class="flex-1 min-w-0">
      <h3
        class:list={[
          "font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-sky-400 transition-colors",
          variant === "compact" ? "text-lg" : "text-xl",
        ]}
      >
        {tech.name}
      </h3>
      {/* Level badge */}
      {tech.level && levelConfig && (
        <span
          class:list={[
            "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium mt-1",
            levelConfig.bgColor,
            levelConfig.color,
          ]}
        >
          {getTranslatedLevel(tech.level)}
        </span>
      )}
    </div>
  </div>

  <!-- Description -->
  {tech.description && (
    <p class:list={[
      "text-gray-600 dark:text-gray-400 mb-4",
      variant === "compact" ? "text-sm line-clamp-2" : "text-sm line-clamp-3",
    ]}>
      {tech.description}
    </p>
  )}

  <!-- External Link (for detailed variant) -->
  {variant === "detailed" && tech.link && (
    <div class="mt-4">
      <span
        class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-sky-400 hover:text-blue-700 dark:hover:text-sky-300"
      >
        <Icon name="mdi:open-in-new" class="h-4 w-4" />
        {isRtl ? "المزيد" : "Learn more"}
      </span>
    </div>
  )}

  <!-- Hover Arrow (compact variant) -->
  {variant === "compact" && (
    <div class="mt-auto flex items-center gap-1 text-sm font-medium text-blue-600 dark:text-sky-400 opacity-0 group-hover:opacity-100 transition-opacity pt-2">
      <span>{isRtl ? "عرض التفاصيل" : "View details"}</span>
      <Icon name={isRtl ? "mdi:arrow-left" : "mdi:arrow-right"} class="h-4 w-4" />
    </div>
  )}
</a>
