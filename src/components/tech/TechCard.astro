---
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";

interface Props {
  name: string;
  icon?: string;
  level?: string;
  class?: string;
  style?: string;
  slug?: string;
  category?: string;
  description?: string;
}

const {
  name,
  icon,
  level,
  class: className,
  style,
  slug,
  category,
  description,
} = Astro.props;
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Function to translate category (using short names)
const getTranslatedCategory = (category: string) => {
  const categoryKey = category.replace(/\s/g, '').toLowerCase().replace('editor', 'Editor').replace('framework', 'Framework');
  const shortTranslationKey = `tech.categories.short.${categoryKey}`;
  return t(shortTranslationKey as any) || category
    .replace(/(^|\s)\S/g, (l: string) => l.toUpperCase())
    .replace("Os", "OS")
    .replace("Cms", "CMS")
    .replace("Dns", "DNS");
};

// Function to translate level
const getTranslatedLevel = (level: string) => {
  switch (level.toLowerCase()) {
    case 'expert': return t('tech.level.expert');
    case 'advanced': return t('tech.level.advanced');
    case 'intermediate': return t('tech.level.intermediate');
    case 'beginner': return t('tech.level.beginner');
    case 'novice': return t('tech.level.novice');
    default: return level;
  }
};

const displayCategory = category ? getTranslatedCategory(category) : "";
const translatedLevel = level ? getTranslatedLevel(level) : "";

const categoryHeading = displayCategory
  ? `${t('tech.favorite')} ${displayCategory}`
  : t('tech.favorite');
---

<a href={lang === 'en' ? `/tech/#${slug}` : `/${lang}/tech/#${slug}`} class="block h-full w-full"
transition:name={"tech-card-" + slug}
>
  <div
    class={[
      "flex flex-col items-center justify-between h-full w-full rounded-3xl border-2 border-blue-500 light:bg-blue-50 p-8 shadow-md transition-all duration-250 ease-out hover:shadow-xl hover:border-blue-600 light:hover:bg-blue-50/90",
      " dark:border-sky-800 dark:bg-gradient-to-br dark:from-slate-900/80 dark:via-slate-800/80 dark:to-slate-900/60 dark:shadow-md dark:hover:shadow-xl dark:hover:border-sky-700",
      className,
    ].join(" ")}
    style={style}
  >
    <h4
      class="mb-3 text-center text-2xl font-bold text-blue-700 dark:text-sky-300"
    >
      {categoryHeading}
    </h4>
    <div class="mb-5 flex items-center justify-center gap-4"  transition:name={"tech-" + slug}>
      {
        icon && (
          <Icon name={icon}   class="h-12 w-12 text-blue-700 dark:text-sky-300" />
        )
      }
      <span class="text-3xl font-semibold text-blue-700 dark:text-sky-200"
        >{name}</span
      >
    </div>
    {
      level && (
        <span class="mb-2 inline-block rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-700 dark:bg-sky-900/60 dark:text-sky-200">
          {translatedLevel} · {displayCategory}
        </span>
      )
    }
  </div>
</a>
