---
import { Icon } from 'astro-icon/components';
import { getAllSeries } from '@/data/series';
import type { SeriesData } from '@/data/series';

interface Props {
  lang: string;
  currentSeries?: string;
}

const { lang, currentSeries } = Astro.props;
const allSeries = getAllSeries();
const filteredSeries = allSeries.filter((series: SeriesData) => series.slug !== currentSeries);
---

{filteredSeries.filter(s => s.status !== 'planned' || s.total_parts > 0).length > 0 && (
  <div class="lg:sticky lg:top-20">
    <h2 class="text-lg font-bold mb-3 text-gray-900 dark:text-white">
      {lang === 'ar' ? 'السلاسل' : 'Series'}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-3">
      {filteredSeries.map((series: SeriesData) => (
        <a
        href={`/${lang === 'ar' ? 'ar/' : ''}blog/series/${series.slug}`}
        class="block rounded-lg p-4 text-white shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02]"
        style={`background: linear-gradient(135deg, ${series.color} 0%, ${series.color}dd 100%);`}
        transition:name={"series-card-" + series.slug}
        >
          <div class="flex items-center gap-2 mb-2">
            <div class="text-2xl">
              <Icon name={series.icon} class="w-6 h-6" />
            </div>
            <h3 class="text-sm font-bold flex-1">
              {lang === 'ar' ? series.titleAr : series.title}
            </h3>
          </div>
          <p class="text-xs text-white/90 mb-2 line-clamp-2">
            {lang === 'ar' ? series.descriptionAr : series.description}
          </p>
          <div class="flex items-center gap-2 text-xs text-white/80">
            <span class="px-2 py-0.5 bg-white/20 rounded-full">
              {series.total_parts} {lang === 'ar' ? ' أجزاء' : ' parts'}
            </span>
            <span class="px-2 py-0.5 bg-white/20 rounded-full capitalize">
              {series.status === 'completed' && (lang === 'ar' ? 'مكتمل' : 'Completed')}
              {series.status === 'ongoing' && (lang === 'ar' ? 'جاري' : 'Ongoing')}
              {series.status === 'planned' && (lang === 'ar' ? 'مخطط' : 'Planned')}
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
)}
