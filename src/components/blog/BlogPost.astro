---
import MainLayout from "@layouts/MainLayout.astro";
import PostHeader from "./PostHeader.astro";
import PostContent from "./PostContent.astro";
import type { CollectionEntry } from "astro:content";
import { getLangFromUrl } from "@i18n/utils";
import { useTranslations } from "@i18n/translations";

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props as Props;
const { data } = post;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = "",
  description = "",
  image = {
    src: "",
    alt: t('blog.postHeaderImage'),
  }, // Ensure image is an object with src and alt
} = data;

const pageTitle =
  (title ? title : t('blog.untitledPost')) + " | " + t('page.blogPage.title');

// Format date for schema
const publishedDate = data.date ? new Date(data.date).toISOString() : new Date().toISOString();
const modifiedDate = data.updatedDate ? new Date(data.updatedDate).toISOString() : publishedDate;

// Get absolute URL for the post
const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = image.src ? new URL(image.src, Astro.site).toString() : undefined;
---

<MainLayout title={pageTitle} {description}>
  <!-- Article Schema for Blog Post -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": imageUrl,
    "datePublished": publishedDate,
    "dateModified": modifiedDate,
    "author": {
      "@type": "Person",
      "name": "Saif Abdelrazek",
      "url": "https://saifabdelrazek.com",
      "alternateName": "A8K"
    },
    "publisher": {
      "@type": "Person",
      "name": "Saif Abdelrazek",
      "url": "https://saifabdelrazek.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": postUrl
    },
    "keywords": data.tags?.join(", ") || "",
    "articleSection": "Technology",
    "inLanguage": lang === "ar" ? "ar" : "en"
  })} />

  <div
    class="relative min-h-screen w-full bg-blue-50 transition-colors duration-300 dark:bg-gradient-to-br dark:from-[#0f172a] dark:via-[#1e293b] dark:to-[#0a192f]"
   transition:name={"post-card-" + post.id}
    >
    <PostHeader {post} />

    <div class="relative z-10 mx-auto -mt-32 max-w-4xl px-2 pb-12">
      <section
        class="rounded-2xl border border-blue-100 bg-blue-50 p-6 pt-4 shadow-2xl backdrop-blur-md transition-colors duration-300 dark:border-sky-900 dark:bg-gradient-to-br dark:from-slate-900 dark:via-slate-800 dark:to-slate-900 dark:shadow-2xl dark:backdrop-blur-md"
      >
        <PostContent {post} />
      </section>
    </div>
  </div>
</MainLayout>
