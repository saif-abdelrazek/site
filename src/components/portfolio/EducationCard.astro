---
import { Icon } from "astro-icon/components";
import { SECTION_CONFIG } from "@types/educationTypes";
import type { EducationSection } from "@types/educationTypes";

interface EducationCardProps {
  institution: CollectionEntry<"institutions">;
  section: string;
  t: (key: string) => string;
  lang: string;
}

const { institution, section, t, lang } = Astro.props as EducationCardProps;

const sectionConfig = SECTION_CONFIG[section as EducationSection];

const url = lang === "en"
  ? `/education/${institution.data.slug}`
  : `/${lang}/education/${institution.data.slug}`;
---

<a
  href={url}
  class="group flex h-full flex-col rounded-2xl border border-blue-200 light:bg-white p-5 shadow-md transition-all duration-250 ease-out hover:shadow-lg hover:border-blue-400 light:hover:bg-blue-50/30 light:border-blue-200 light:bg-white light:hover:shadow-lg light:hover:border-blue-400 light:hover:bg-blue-50/30 dark:border-sky-900 dark:bg-slate-800 dark:hover:border-sky-700"
>
  {/* Section Icon */}
  <div class="flex justify-start mb-3">
    <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-100 to-sky-100 light:from-blue-100 light:to-sky-100 dark:from-sky-900/40 dark:to-blue-900/40">
      <Icon name={sectionConfig.icon} class="h-8 w-8 text-blue-600 light:text-blue-600 dark:text-sky-400" />
    </div>
  </div>

  {/* Institution Logo */}
  {institution.data.logo && (
    <img
      src={institution.data.logo.src}
      alt={institution.data.name}
      class="mb-3 h-12 w-12 rounded-xl border-2 border-blue-200 object-cover shadow-sm light:border-blue-200 dark:border-sky-900"
      loading="lazy"
    />
  )}

  {/* Top Row: Section Badge + Current Status */}
  <div class="flex items-center justify-between mb-3">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-700 dark:bg-sky-900/60 dark:text-sky-200 light:bg-blue-100 light:text-blue-700">
      {section === 'formal' ? t('education.formal.title') : t('education.selfLearning.title')}
    </span>
    {institution.data.current && (
      <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 light:bg-green-100 light:text-green-700 dark:bg-green-900/40 dark:text-green-300">
        <span class="h-1.5 w-1.5 rounded-full bg-green-500 animate-pulse"></span>
        {t('education.current')}
      </span>
    )}
  </div>

  {/* Institution Name */}
  <h3 class="mb-1 text-start text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors light:text-gray-900 light:group-hover:text-blue-600 dark:text-white dark:group-hover:text-sky-400">
    {institution.data.name}
  </h3>

  {/* Role */}
  <div class="mb-0.5 text-start text-sm font-medium text-blue-500 light:text-blue-500 dark:text-sky-400">
    {institution.data.role}
  </div>

  {/* Dates */}
  <div class="mb-1 text-start text-xs text-gray-500 light:text-gray-500 dark:text-gray-400">
                {institution.data.period}
  {/* Description */}
  {institution.data.description && (
    <p class="text-start text-sm text-gray-600 light:text-gray-600 dark:text-gray-300 line-clamp-3">
      {institution.data.description}
    </p>
  )}

  {/* Location */}
  {institution.data.location && (
    <div class="mb-0.5 text-start text-xs text-gray-500 light:text-gray-500 dark:text-gray-400">
      {institution.data.location}
    </div>
  )}

  {/* Learn More */}
  <div class="mt-auto flex items-center gap-1 text-sm font-medium text-blue-600 dark:text-sky-400 opacity-0 group-hover:opacity-100 transition-opacity pt-2">
    <span>{t('ui.learnmore')}</span>
    <Icon name={t('ui.arrow')} class="h-4 w-4" />
  </div>
</a>