---
/**
 * CareerLayout Component
 *
 * A unified layout for career-related pages (technologies, education, a8k)
 * Provides consistent hero section styling and structure
 */

import MainLayout from "@layouts/MainLayout.astro";
import { Icon } from "astro-icon/components";
import Button from "@components/ui/Button.astro";

export interface HeroConfig {
  /** Gradient colors for light mode */
  gradientFrom: string;
  gradientVia: string;
  gradientTo: string;
  /** Decorative blur elements */
  decorativeTop: {
    position: string;
    color: string;
  };
  decorativeBottom: {
    position: string;
    color: string;
  };
  /** Hero content */
  icon: string;
  subtitle: string;
  title: string;
  description: string;
  /** Optional stats to display */
  stats?: Array<{
    value: string | number;
    label: string;
  }>;
  /** Optional navigation buttons */
  navigation?: Array<{
    href: string;
    icon: string;
    label: string;
  }>;
}

export interface Props {
  title: string;
  description: string;
  hero: HeroConfig;
  children?: any;
}

const {
  title,
  description,
  hero,
  children
} = Astro.props;
---

<MainLayout title={title} description={description}>
  <!-- Hero Section -->
  <div class={`relative bg-gradient-to-br from-${hero.gradientFrom} via-${hero.gradientVia} to-${hero.gradientTo} dark:from-slate-900 dark:via-slate-800 dark:to-slate-900`}>
    <!-- Decorative elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class={`absolute ${hero.decorativeTop.position} h-80 w-80 rounded-full ${hero.decorativeTop.color} blur-3xl`}></div>
      <div class={`absolute ${hero.decorativeBottom.position} h-80 w-80 rounded-full ${hero.decorativeBottom.color} blur-3xl`}></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="max-w-4xl">
        <div class="flex items-center gap-2 mb-4">
          <Icon name={hero.icon} class="h-8 w-8 text-blue-200" />
          <span class="text-blue-200 font-medium">
            {hero.subtitle}
          </span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          {hero.title}
        </h1>
        <p class="text-xl text-blue-100 leading-relaxed mb-8">
          {hero.description}
        </p>

        <!-- Optional Stats -->
        {hero.stats && hero.stats.length > 0 && (
          <div class="flex flex-wrap gap-6 mb-8">
            {hero.stats.map((stat) => (
              <div class="flex items-center gap-2">
                <span class="text-3xl font-bold text-white">{stat.value}</span>
                <span class="text-blue-200">{stat.label}</span>
              </div>
            ))}
          </div>
        )}

        <!-- Optional Navigation -->
        {hero.navigation && hero.navigation.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {hero.navigation.map((nav) => (
              <Button variant="filter" href={nav.href}>
                <Icon name={nav.icon} class="h-4 w-4" />
                {nav.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <main class="bg-white dark:bg-slate-900">
    <slot />
  </main>

  <!-- Back to Top Button -->
  <a
    id="backToTop"
    href="#"
    class="pointer-events-none fixed right-6 bottom-6 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-blue-600 text-white opacity-0 shadow-lg transition-all duration-300 hover:bg-blue-700 dark:bg-indigo-600 dark:hover:bg-indigo-700"
    aria-label="Back to top"
  >
    <Icon name="mdi:arrow-up" class="h-5 w-5" />
  </a>

  <script>
    const initBackToTop = () => {
      const btn = document.getElementById("backToTop");
      if (!btn) return;

      window.addEventListener("scroll", () => {
        if (window.scrollY > 400) {
          btn.classList.remove("opacity-0", "pointer-events-none");
          btn.classList.add("opacity-100", "pointer-events-auto");
        } else {
          btn.classList.add("opacity-0", "pointer-events-none");
          btn.classList.remove("opacity-100", "pointer-events-auto");
        }
      });

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    };

    document.addEventListener("DOMContentLoaded", initBackToTop);
    document.addEventListener("astro:after-swap", initBackToTop);
  </script>
</MainLayout>